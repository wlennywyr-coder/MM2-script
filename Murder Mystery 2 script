-- LOGIQUE 2 : AUTOFARM SOUS LA MAP (PIÈCES, BONBONS, FLOCONS)
-- ============================================================================
local function GetCoinPart(obj)
    if obj:IsA("BasePart") then return obj end
    if obj:IsA("Model") then
        return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
    end
    return nil
end

local function IsCollectibleAvailable(coinObj)
    if not coinObj or not coinObj.Parent then return false end
    if CollectedCoins[coinObj] then return false end
    local part = GetCoinPart(coinObj)
    if not part then return false end

    -- Ignore les pièces déjà ramassées (devenues transparentes)
    local coinVisual = coinObj:FindFirstChild("CoinVisual")
    if coinVisual and coinVisual:IsA("BasePart") and coinVisual.Transparency >= 0.95 then
        return false
    end
    if part.Transparency >= 0.95 and not coinVisual then
        return false
    end
    return true
end

local function FindNextCollectible()
    local myRoot = GetRootPart(LocalPlayer)
    if not myRoot then return nil end

    local bestPart = nil
    local bestObj = nil
    local minDist = math.huge

    -- 1. Recherche prioritaire dans tous les CoinContainer de la carte active
    for _, desc in ipairs(Workspace:GetDescendants()) do
        if desc.Name == "CoinContainer" then
            for _, child in ipairs(desc:GetChildren()) do
                if IsCollectibleAvailable(child) then
                    local part = GetCoinPart(child)
                    if part then
                        local d = (part.Position - myRoot.Position).Magnitude
                        if d < minDist and d < 350 then
                            minDist = d
                            bestPart = part
                            bestObj = child
                        end
                    end
                end
            end
        elseif (Settings.AutoFarmEvents or Settings.AutoFarmCoins) and desc:IsA("BasePart") then
            local lname = string.lower(desc.Name)
            if (lname == "coin_server" or string.find(lname, "candy") or string.find(lname, "snow")) and IsCollectibleAvailable(desc) then
                local d = (desc.Position - myRoot.Position).Magnitude
                if d < minDist and d < 350 then
                    minDist = d
                    bestPart = desc
                    bestObj = desc
                end
            end
        end
    end

    return bestPart, bestObj, minDist
end

-- Orientation couchée sur le dos/ventre à l'horizontale sous la map
local ProneRotation = CFrame.Angles(math.rad(90), 0, 0)

task.spawn(function()
    while task.wait(0.1) do
        if Settings.AutoFarmCoins or Settings.AutoFarmEvents then
            local myRoot = GetRootPart(LocalPlayer)
            local targetPart, targetObj, dist = FindNextCollectible()

            if myRoot and targetPart and targetObj then
                -- Place d'abord le joueur sous le niveau de la pièce en position couchée
                local underPos = Vector3.new(targetPart.Position.X, targetPart.Position.Y + Settings.UnderMapOffset, targetPart.Position.Z)
                local currentUnder = Vector3.new(myRoot.Position.X, underPos.Y, myRoot.Position.Z)
                myRoot.CFrame = CFrame.new(currentUnder) * ProneRotation
                myRoot.AssemblyLinearVelocity = Vector3.zero

                local duration = math.clamp(dist / Settings.FarmSpeed, 0.12, 2.2)
                local moveTween = TweenService:Create(
                    myRoot,
                    TweenInfo.new(duration, Enum.EasingStyle.Linear),
                    {CFrame = CFrame.new(underPos) * ProneRotation}
                )
                moveTween:Play()

                local elapsed = 0
                while elapsed < duration and (Settings.AutoFarmCoins or Settings.AutoFarmEvents) do
                    if not targetObj.Parent then break end
                    myRoot.AssemblyLinearVelocity = Vector3.zero
                    elapsed = elapsed + task.wait()
                end
                moveTween:Cancel()

                -- Remonte brièvement toucher la hitbox de la pièce en restant couché, puis redescend sous la map
                if (Settings.AutoFarmCoins or Settings.AutoFarmEvents) and targetPart and targetPart.Parent then
                    local touchPos = Vector3.new(targetPart.Position.X, targetPart.Position.Y - 0.5, targetPart.Position.Z)
                    myRoot.CFrame = CFrame.new(touchPos) * ProneRotation

                    if firetouchinterest then
                        pcall(function()
                            firetouchinterest(myRoot, targetPart, 0)
                            firetouchinterest(myRoot, targetPart, 1)
                        end)
                    end
                    task.wait(0.12)

                    -- Marque la pièce comme collectée pour passer immédiatement à la suivante
                    CollectedCoins[targetObj] = true

                    -- Redescend en sécurité sous la carte
                    local safePos = Vector3.new(touchPos.X, touchPos.Y + Settings.SafeWaitDepth, touchPos.Z)
                    myRoot.CFrame = CFrame.new(safePos) * ProneRotation
                end
            elseif myRoot then
                -- S'il n'y a aucune pièce proche, reste allongé en sécurité sous la map
                myRoot.AssemblyLinearVelocity = Vector3.zero
                myRoot.CFrame = CFrame.new(myRoot.Position.X, myRoot.Position.Y, myRoot.Position.Z) * ProneRotation
            end
        end
    end
end)

