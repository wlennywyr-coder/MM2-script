local function RefreshTabButtonsTheme()
	for name, btnData in pairs(TabButtons) do
		local isSelected = (name == CurrentActiveTabName)
		local isPastel = IsPastelLightAccent(Config.SelectedTheme)
		local selectedTextCol = isPastel and ActivePalette.KnobOn or Color3.fromRGB(255, 255, 255)
		TweenService:Create(btnData.Button, TweenInfo.new(0.18), {
			BackgroundColor3 = isSelected and Theme.Accent or Theme.MainBg,
			BackgroundTransparency = isSelected and 0.06 or 1
		}):Play()
