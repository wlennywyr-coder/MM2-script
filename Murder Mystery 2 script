local function FindActiveCoinContainer()
    for _, desc in ipairs(Workspace:GetDescendants()) do
        if desc.Name == "CoinContainer" and #desc:GetChildren() > 0 then
            return desc
        end
    end
    return nil
end

local function IsBagFull()
    local pGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not pGui then return false end

    for _, desc in ipairs(pGui:GetDescendants()) do
        if desc:IsA("TextLabel") and desc.Visible then
            local txt = string.lower(desc.Text)
            if txt == "full" or txt == "full!" then
                local parentFrame = desc.Parent
                if parentFrame and parentFrame:IsA("GuiObject") and parentFrame.Visible then
                    return true
                end
            end
            local cur, max = string.match(txt, "^(%d+)%s*/%s*(%d+)$")
            if cur and max and tonumber(cur) and tonumber(max) and tonumber(max) > 0 then
                if tonumber(cur) >= tonumber(max) then
                    return true
                end
            end
        end
    end
    return false
end

local function CleanFarmPhysics()
    local root = GetRootPart(LocalPlayer)
    local hum = GetHumanoid(LocalPlayer)
    if root then
        local bv = root:FindFirstChild("HarmonyFarmBV")
        if bv then bv:Destroy() end
        local bg = root:FindFirstChild("HarmonyFarmBG")
        if bg then bg:Destroy() end
        local av = root:FindFirstChild("HarmonyFlingAV")
        if av then av:Destroy() end
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
    if hum then
        hum.PlatformStand = false
        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
    end
    local char = GetCharacter(LocalPlayer)
    if char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and (part.Name == "HumanoidRootPart" or part.Name == "Torso" or part.Name == "UpperTorso" or part.Name == "LowerTorso") then
                part.CanCollide = true
            end
        end
    end
end

local function ReturnToMapSurface()
    CleanFarmPhysics()
    local root = GetRootPart(LocalPlayer)
    if root then
        if LastSafeMapPosition then
            root.CFrame = CFrame.new(LastSafeMapPosition + Vector3.new(0, 4.5, 0))
        else
            root.CFrame = CFrame.new(root.Position + Vector3.new(0, 6, 0))
        end
    end
end

