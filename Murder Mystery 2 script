local function FireSilentAimInstant(gun, remote)
	if not Config.SilentAim then return end
	local murderer = GetMurdererInstant()
	if not murderer or murderer == LocalPlayer or not IsAlive(murderer) then return end

	local targetPos, targetCF = GetMurdererTargetData(murderer)
	if not targetPos then return end

	if remote then
		task.spawn(function()
			pcall(function()
				remote:InvokeServer(1, targetPos, "AH2")
			end)
		end)
	end

	DispatchMM2GunRemotes(gun, targetPos, targetCF)
	for _, delayTime in ipairs({0.01, 0.03, 0.06, 0.10}) do
		task.delay(delayTime, function()
			if Config.SilentAim and gun and gun.Parent == GetCharacter(LocalPlayer) then
				local m = GetMurdererInstant()
				if m and IsAlive(m) then
					local p, cf = GetMurdererTargetData(m)
					if p then
						if remote then
							task.spawn(function()
								pcall(function()
									remote:InvokeServer(1, p, "AH2")
								end)
							end)
						end
						DispatchMM2GunRemotes(gun, p, cf)
					end
				end
			end
		end)
	end
end

local function RebindSilentAimLIFO(gun)
	if not Config.SilentAim or not gun then
		DisconnectSilentAimHooks()
		return
	end
	local char = GetCharacter(LocalPlayer)
	if not char or gun.Parent ~= char then
		DisconnectSilentAimHooks()
		return
	end

	local knifeScript = gun:FindFirstChild("KnifeLocal")
	local cb = (knifeScript and knifeScript:FindFirstChild("CreateBeam")) or gun:FindFirstChild("CreateBeam", true)
	local remote = cb and (cb:FindFirstChild("RemoteFunction") or cb:FindFirstChildWhichIsA("RemoteFunction"))

	DisconnectSilentAimHooks()

	Runtime.SilentAimGunConn = gun.Activated:Connect(function()
		FireSilentAimInstant(gun, remote)
	end)

	if LocalMouse then
		Runtime.SilentAimMouseConn = LocalMouse.Button1Down:Connect(function()
			if gun.Parent == char then
				FireSilentAimInstant(gun, remote)
			end
		end)
	end
end

