-- Wrapper Système de Fichiers avec Fallback en mémoire (_G.HarmonySettings)
local FileSystem = {
	Folder = "HarmonyHub",
	File = "HarmonyHub/MM2_Config.json"
}

function FileSystem:HasNativeFS()
	return type(writefile) == "function"
		and type(readfile) == "function"
		and type(isfile) == "function"
		and type(isfolder) == "function"
		and type(makefolder) == "function"
end

function FileSystem:Save(dataTable)
	_G.HarmonySettings = dataTable
	if self:HasNativeFS() then
		pcall(function()
			if not isfolder(self.Folder) then
				makefolder(self.Folder)
			end
			writefile(self.File, HttpService:JSONEncode(dataTable))
		end)
	end
end

function FileSystem:Load()
	if self:HasNativeFS() then
		local ok, content = pcall(function()
			if isfile(self.File) then
				return readfile(self.File)
			end
			return nil
		end)
		if ok and content and #content > 0 then
			local decodeOk, decoded = pcall(function()
				return HttpService:JSONDecode(content)
			end)
			if decodeOk and type(decoded) == "table" then
				_G.HarmonySettings = decoded
				return decoded
			end
		end
	end
	if type(_G.HarmonySettings) == "table" then
		return _G.HarmonySettings
	end
	return nil
end

-- Conteneur GUI adaptatif sécurisé
local function GetSafeGuiParent()
	if type(gethui) == "function" then
		local ok, hui = pcall(gethui)
		if ok and typeof(hui) == "Instance" then
			return hui
		end
	end

	local okCore, coreGui = pcall(function()
		return Services.CoreGui
	end)
	if okCore and coreGui then
		local testOk = pcall(function()
			local testFolder = Instance.new("Folder")
			testFolder.Name = "HarmonyAccessCheck"
			testFolder.Parent = coreGui
			testFolder:Destroy()
		end)
		if testOk then
			return coreGui
		end
	end

	return LocalPlayer:WaitForChild("PlayerGui")
end

