-- VISUALS, FAST ESP REFRESH, INSTANT KILL ALL & GUN DROP CHAM
-- ============================================================================
RunService.RenderStepped:Connect(function()
    local myChar = GetCharacter(LocalPlayer)
    local myRoot = GetRootPart(LocalPlayer)

    if Settings.FlingTarget or Settings.FlingMurderer or Settings.FlingSheriff then
        if myRoot then
            myRoot.AssemblyLinearVelocity = Vector3.zero
        end
    end

    -- Update TopBar Role Banner (Automatically clears when in Lobby between rounds)
    local murdPlayer = FindMurderer()
    local sherPlayer = FindSheriff()
    if RoundIsActive and (murdPlayer or sherPlayer) then
        RoleBanner.Text = string.format(
            "Murderer: %s  |  Sheriff: %s",
            murdPlayer and murdPlayer.Name or "None",
            sherPlayer and sherPlayer.Name or "None"
        )
    else
        RoleBanner.Text = "Lobby (Waiting for new round...)"
    end

    -- Spectate Target
    if Settings.SpectateTarget and Settings.SelectedTarget then
        local tHum = GetHumanoid(Settings.SelectedTarget)
        if tHum then Camera.CameraSubject = tHum end
    end

    -- Loop Go To Target
    if Settings.LoopGoToTarget and Settings.SelectedTarget and myRoot then
        local tRoot = GetRootPart(Settings.SelectedTarget)
        if tRoot then myRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0, 3) end
    end

    -- Murderer Combat: Instant Kill All (Lobby-Safe) & Knife Aura
    if HasItem(LocalPlayer, "Knife") and IsPlayerInActiveMap(LocalPlayer) and myRoot then
        if Settings.AutoKillAll then
            ExecuteInstantKillAll()
        elseif Settings.AuraDistance > 5 then
            local knife = myChar and myChar:FindFirstChild("Knife")
            local handle = knife and (knife:FindFirstChild("Handle") or knife:FindFirstChildWhichIsA("BasePart"))
            if handle then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and IsPlayerInActiveMap(p) then
                        local pRoot = GetRootPart(p)
                        if pRoot and (pRoot.Position - myRoot.Position).Magnitude <= Settings.AuraDistance then
                            if firetouchinterest then
                                pcall(function()
                                    firetouchinterest(handle, pRoot, 0)
                                    firetouchinterest(handle, pRoot, 1)
                                end)
                            end
                        end
                    end
                end
            end
        end
    end

    -- Sheriff Combat (Blatant Kill & Auto Shoot)
    if murdPlayer and myRoot and IsPlayerInActiveMap(LocalPlayer) and IsPlayerInActiveMap(murdPlayer) then
        local murdRoot = GetRootPart(murdPlayer)
        if murdRoot then
            if Settings.KillMurdererBlatant then
                myRoot.CFrame = murdRoot.CFrame * CFrame.new(0, 0, 5)
                ShootMurdererNow()
            elseif Settings.AutoShootMurderer then
                local params = RaycastParams.new()
                params.FilterDescendantsInstances = {myChar}
                params.FilterType = Enum.RaycastFilterType.Exclude
                local ray = Workspace:Raycast(myRoot.Position, murdRoot.Position - myRoot.Position, params)
                if ray and ray.Instance and ray.Instance:IsDescendantOf(murdPlayer.Character) then
                    ShootMurdererNow()
                end
            end
        end
    end

    -- Fast Player Chams & Name ESP (Clears old roles when players are in Lobby)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local char = p.Character
            local role = GetPlayerRole(p)
            local isDeadOrLobby = (not RoundIsActive) or CachedDeadPlayers[p.Name]

            local roleColor = Theme.InnocentESP
            local roleLabel = "Innocent"

            if role == "Murderer" then
                roleColor = Theme.MurdererESP
                roleLabel = "Murderer"
            elseif role == "Sheriff" then
                roleColor = Theme.SheriffESP
                roleLabel = "Sheriff"
            elseif isDeadOrLobby then
                roleColor = Theme.TextMuted
                roleLabel = "Lobby"
            end

            local hl = char:FindFirstChild("HarmonyCham")
            if Settings.PlayerChams then
                if not hl then
                    hl = Instance.new("Highlight")
                    hl.Name = "HarmonyCham"
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    hl.FillTransparency = 0.4
                    hl.OutlineTransparency = 0.05
                    hl.Parent = char
                end
                hl.Adornee = char
                hl.FillColor = roleColor
                hl.OutlineColor = roleColor
            elseif hl then
                hl:Destroy()
            end

            local head = char:FindFirstChild("Head")
            if head then
                local bGui = head:FindFirstChild("HarmonyNameESP")
                if Settings.NameESP then
                    if not bGui then
                        bGui = Instance.new("BillboardGui")
                        bGui.Name = "HarmonyNameESP"
                        bGui.Size = UDim2.new(0, 160, 0, 28)
                        bGui.StudsOffset = Vector3.new(0, 2.6, 0)
                        bGui.AlwaysOnTop = true
                        bGui.Parent = head

                        local tag = Instance.new("TextLabel")
                        tag.Name = "Tag"
                        tag.Size = UDim2.new(1, 0, 1, 0)
                        tag.BackgroundTransparency = 1
                        tag.Font = Enum.Font.GothamBold
                        tag.TextSize = 12
                        tag.TextStrokeTransparency = 0.25
                        tag.Parent = bGui
                    end
                    bGui.Tag.Text = string.format("%s [%s]", p.Name, roleLabel)
                    bGui.Tag.TextColor3 = roleColor
                elseif bGui then
                    bGui:Destroy()
                end
            end
        end
    end

    -- Gun Drop Cham + Wall-Through Beacon (Fixed for all MM2 maps)
    if CachedGunDrop and CachedGunDrop.Parent then
        local gunPart = CachedGunDrop:IsA("BasePart") and CachedGunDrop or CachedGunDrop:FindFirstChildWhichIsA("BasePart", true)
        if gunPart then
            local gCham = CachedGunDrop:FindFirstChild("HarmonyGunCham")
            local gGui = gunPart:FindFirstChild("HarmonyGunBeacon")

            if Settings.GunCham then
                if not gCham then
                    gCham = Instance.new("Highlight")
                    gCham.Name = "HarmonyGunCham"
                    gCham.Adornee = CachedGunDrop
                    gCham.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    gCham.FillColor = Theme.GunDropColor
                    gCham.OutlineColor = Color3.fromRGB(255, 255, 255)
                    gCham.FillTransparency = 0.15
                    gCham.OutlineTransparency = 0
                    gCham.Parent = CachedGunDrop
                end
                if not gGui then
                    gGui = Instance.new("BillboardGui")
                    gGui.Name = "HarmonyGunBeacon"
                    gGui.Size = UDim2.new(0, 140, 0, 30)
                    gGui.StudsOffset = Vector3.new(0, 2, 0)
                    gGui.AlwaysOnTop = true
                    gGui.Parent = gunPart

                    local lbl = Instance.new("TextLabel")
                    lbl.Size = UDim2.new(1, 0, 1, 0)
                    lbl.BackgroundTransparency = 1
                    lbl.Text = "★ [ GUN DROP ] ★"
                    lbl.Font = Enum.Font.GothamBlack
                    lbl.TextSize = 13
                    lbl.TextColor3 = Theme.GunDropColor
                    lbl.TextStrokeTransparency = 0.1
                    lbl.Parent = gGui
                end
            else
                if gCham then gCham:Destroy() end
                if gGui then gGui:Destroy() end
            end
        end
    end
end)

