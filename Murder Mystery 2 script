    PageLayout.Parent = Page

    local PagePadding = Instance.new("UIPadding")
    PagePadding.PaddingTop = UDim.new(0, 4)
    PagePadding.PaddingBottom = UDim.new(0, 16)
    PagePadding.PaddingLeft = UDim.new(0, 20)
    PagePadding.PaddingRight = UDim.new(0, 20)
    PagePadding.Parent = Page

    local tabData = {Button = TabBtn, Label = Label, Indicator = Indicator, Page = Page, Order = 0}
    table.insert(Tabs, tabData)

    local function Activate()
        for _, t in ipairs(Tabs) do
            t.Page.Visible = false
            t.Indicator.Visible = false
            t.Label.TextColor3 = Theme.TextMuted
            t.Label.Font = Enum.Font.GothamMedium
            TweenService:Create(t.Button, TweenInfo.new(0.15), {BackgroundTransparency = 1}):Play()
        end
