local function IsCoinActive(item, visualPart)
	if not item or not item.Parent then return false end
	if visualPart and visualPart.Parent then
		if visualPart.Transparency >= 1 then
			return false
		end
	elseif item:IsA("BasePart") and item.Transparency >= 1 then
		return false
	end
	return true
end

local function GetValidCoinsList(coinContainer)
	local validCoins = {}
	if not coinContainer then return validCoins end

	for _, item in ipairs(coinContainer:GetChildren()) do
		if not Runtime.VisitedCoins[item] then
			local coinVisual = item:FindFirstChild("CoinVisual")
			local touchPart = item:IsA("BasePart") and item
				or (coinVisual and coinVisual:IsA("BasePart") and coinVisual)
				or item:FindFirstChildWhichIsA("BasePart")
			local visualPart = (coinVisual and coinVisual:IsA("BasePart")) and coinVisual or touchPart

			if touchPart and visualPart and visualPart.Transparency < 1 then
				table.insert(validCoins, {
					ContainerItem = item,
					TouchPart = touchPart,
					VisualPart = visualPart,
					Position = touchPart.Position
				})
			end
		end
	end

	return validCoins
end

local function SelectTargetCoin(coins, localHRP)
	if #coins == 0 then return nil end

	local murd = Runtime.MurdererPlayer
	local murdHRP = (murd and murd ~= LocalPlayer and IsAlive(murd)) and GetRootPart(murd) or nil
	local avoidActive = (Config.AvoidMurderer or Config.FarmMode == "Safe") and (murdHRP ~= nil)

	if avoidActive then
		local murdPos = murdHRP.Position
		local playerToMurdDist = (localHRP.Position - murdPos).Magnitude

		if playerToMurdDist < 35 then
			local bestFarCoin = nil
			local maxMurdDist = -1
			for _, entry in ipairs(coins) do
				local distFromMurd = (entry.Position - murdPos).Magnitude
				if distFromMurd > maxMurdDist then
					maxMurdDist = distFromMurd
					bestFarCoin = entry
				end
			end
			if bestFarCoin then
				return bestFarCoin
			end
		end

		local bestSafeCoin = nil
		local bestDist = math.huge
		for _, entry in ipairs(coins) do
			local distFromMurd = (entry.Position - murdPos).Magnitude
			local distFromPlayer = (entry.Position - localHRP.Position).Magnitude
			if distFromMurd > 32 and distFromPlayer < bestDist then
				bestDist = distFromPlayer
				bestSafeCoin = entry
			end
		end

		if bestSafeCoin then
			return bestSafeCoin
		end

		local fallbackFarCoin = coins[1]
		local maxDist = -1
		for _, entry in ipairs(coins) do
			local distFromMurd = (entry.Position - murdPos).Magnitude
			if distFromMurd > maxDist then
				maxDist = distFromMurd
				fallbackFarCoin = entry
			end
		end
		return fallbackFarCoin
	end

	if Config.FarmMode == "Random" then
		return coins[math.random(1, #coins)]
	else
		local bestDist = math.huge
		local chosen = nil
		for _, entry in ipairs(coins) do
			local d = (entry.Position - localHRP.Position).Magnitude
			if d < bestDist then
				bestDist = d
				chosen = entry
			end
		end
		return chosen
	end
end

