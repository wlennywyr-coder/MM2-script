-- NOUVEAU MOTEUR DE COMBAT (MANIPULATION LOCALE SANS HOOKS)
-- ============================================================================
local function AimAndShootServer()
    local murderer = FindMurderer()
    if not murderer or not murderer.Character then return end
    local murdRoot = murderer.Character:FindFirstChild("HumanoidRootPart")
    if not murdRoot then return end

    local myChar = GetCharacter(LocalPlayer)
    if not myChar then return end
    local gun = myChar:FindFirstChild("Gun") or myChar:FindFirstChild("Revolver")
    if not gun then
        local bp = LocalPlayer:FindFirstChild("Backpack")
        local bpGun = bp and (bp:FindFirstChild("Gun") or bp:FindFirstChild("Revolver"))
        if bpGun then
            GetHumanoid(LocalPlayer):EquipTool(bpGun)
            task.wait(0.1)
            gun = myChar:FindFirstChild("Gun") or myChar:FindFirstChild("Revolver")
        end
    end
    
    if gun then
        -- Manipulation de la caméra extrêmement rapide (Silent Aim)
        local predictedPos = murdRoot.Position + (murdRoot.AssemblyLinearVelocity * 0.15)
        local oldCam = Camera.CFrame
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, predictedPos)
        
        -- Déclenche l'arme
        gun:Activate()
        
        -- Restaure la caméra instantanément
        RunService.RenderStepped:Wait()
        Camera.CFrame = oldCam
    end
end

-- Intercepte le clic de la souris pour le Silent Aim Magnétique
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe or not Settings.SilentAim then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        local myChar = GetCharacter(LocalPlayer)
        if myChar and (myChar:FindFirstChild("Gun") or myChar:FindFirstChild("Revolver")) then
            if not isShooting then
                isShooting = true
                AimAndShootServer()
                task.wait(0.5)
                isShooting = false
            end
        end
    end
end)

local function ShootMurdererMacro()
    if isShooting then return end
    isShooting = true
    task.spawn(function()
        AimAndShootServer()
        task.wait(0.3)
        isShooting = false
    end)
end

-- Auto Kill All (Manipulation d'ennemis locale)
local function ExecuteImmobileKillAll()
    if isKilling or not HasItem(LocalPlayer, "Knife") then return end
    local myChar = GetCharacter(LocalPlayer)
    local myRoot = GetRootPart(LocalPlayer)
    if not myChar or not myRoot then return end

    isKilling = true
    task.spawn(function()
        local knife = myChar:FindFirstChild("Knife")
        if not knife then
            GetHumanoid(LocalPlayer):EquipTool(LocalPlayer.Backpack:FindFirstChild("Knife"))
            task.wait(0.1)
            knife = myChar:FindFirstChild("Knife")
        end

        if knife then
            -- Active le couteau
            local slash = knife:FindFirstChild("Slash", true) or knife:FindFirstChild("Stab", true)
            if slash and slash:IsA("RemoteEvent") then slash:FireServer(1) end
            knife:Activate()

            -- Téléporte les ennemis sur la lame localement pendant 1 frame pour valider la Hitbox sans bouger
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and IsPlayerInActiveMap(p) then
                    local tRoot = GetRootPart(p)
                    if tRoot then
                        local oldCF = tRoot.CFrame
                        tRoot.CFrame = myRoot.CFrame * CFrame.new(0, 0, -2)
                        RunService.Heartbeat:Wait()
                        if tRoot.Parent then tRoot.CFrame = oldCF end
                    end
                end
            end
        end
        task.wait(0.4)
        isKilling = false
    end)
end

