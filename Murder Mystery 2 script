-- ============================================================================
local function GetCoinPart(obj)
    if obj:IsA("BasePart") then return obj end
    if obj:IsA("Model") then
        return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
    end
    return nil
end

local function IsCoinValid(coinObj)
    if not coinObj or not coinObj.Parent then return false end
    if CollectedCoins[coinObj] then return false end
    local part = GetCoinPart(coinObj)
    if not part then return false end

    local visual = coinObj:FindFirstChild("CoinVisual")
    if visual and visual:IsA("BasePart") and visual.Transparency >= 0.95 then
        return false
    end
    if part.Transparency >= 0.95 and not visual then
        return false
    end
    return true
end

local function GetNearestMapCoin(coinContainer)
    local myRoot = GetRootPart(LocalPlayer)
    if not myRoot or not coinContainer then return nil, nil end

    local bestPart, bestObj = nil, nil
    local minDist = math.huge

    for _, child in ipairs(coinContainer:GetChildren()) do
        if IsCoinValid(child) then
            local part = GetCoinPart(child)
            if part then
                local dist = (Vector3.new(part.Position.X, 0, part.Position.Z) - Vector3.new(myRoot.Position.X, 0, myRoot.Position.Z)).Magnitude
                if dist < minDist then
                    minDist = dist
                    bestPart = part
                    bestObj = child
                end
            end
        end
    end
    return bestPart, bestObj
end

local ProneAngles = CFrame.Angles(math.rad(90), 0, 0)

-- Real-time Step-by-Step Autofarm + Fling Physics on Heartbeat
RunService.Heartbeat:Connect(function(dt)
    local myChar = GetCharacter(LocalPlayer)
    local myRoot = GetRootPart(LocalPlayer)
    local hum = GetHumanoid(LocalPlayer)
    if not (myChar and myRoot and hum and hum.Health > 0) then return end

    -- 1. WALKFLING ENGINE (Works on players inside the match even from the lobby)
    local flingSubject = nil
    if Settings.FlingTarget and Settings.SelectedTarget then
        flingSubject = Settings.SelectedTarget
    elseif Settings.FlingMurderer then
        flingSubject = FindMurderer()
    elseif Settings.FlingSheriff then
        flingSubject = FindSheriff()
    end

    if flingSubject then
        local targetRoot = GetRootPart(flingSubject)
        local targetHum = GetHumanoid(flingSubject)
        if targetRoot and (not targetHum or targetHum.Health > 0) then
            hum.PlatformStand = false
            hum:ChangeState(Enum.HumanoidStateType.Physics)

            -- Keep collision ON for core parts so impulse hits target in the map
            for _, part in ipairs(myChar:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = (part.Name == "HumanoidRootPart" or part.Name == "Torso" or part.Name == "UpperTorso")
                end
            end

            local av = myRoot:FindFirstChild("HarmonyFlingAV")
            if not av then
                av = Instance.new("BodyAngularVelocity")
                av.Name = "HarmonyFlingAV"
                av.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
                av.AngularVelocity = Vector3.new(99999, 99999, 99999)
                av.P = 9e9
                av.Parent = myRoot
            end

            -- Rapidly sweep across the target's velocity path to force collision registration
            local phase = math.sin(os.clock() * 45) * 1.8
            local predicted = targetRoot.Position + (targetRoot.AssemblyLinearVelocity * 0.1) + Vector3.new(phase, 0, -phase)
            myRoot.CFrame = CFrame.new(predicted) * CFrame.Angles(math.rad(math.random(0, 360)), math.rad(math.random(0, 360)), 0)
            myRoot.AssemblyLinearVelocity = Vector3.new(9e4, 9e4, 9e4)
            return
        end
    else
        local av = myRoot:FindFirstChild("HarmonyFlingAV")
        if av then av:Destroy() end
    end

    -- 2. SMART AUTOFARM ENGINE
    if Settings.AutoFarmCoins or Settings.AutoFarmEvents then
        local coinContainer = FindActiveCoinContainer()

        -- Do nothing in the lobby when no active map CoinContainer exists
        if not coinContainer then
            if myRoot:FindFirstChild("HarmonyFarmBV") then
                CleanFarmPhysics()
            end
            BagFullRestored = false
            return
        end

        -- Check if the player's Coin/Candy bag is full
        if IsBagFull() then
            if not BagFullRestored then
                BagFullRestored = true
                if Settings.AutoResetAfterFarm then
                    CleanFarmPhysics()
                    myChar:BreakJoints()
                else
                    -- Return player safely onto the map surface so they can play the rest of the round
                    ReturnToMapSurface()
                end
            end
            return
        end

        local targetPart, targetObj = GetNearestMapCoin(coinContainer)
        if not targetPart then
            -- No coins spawned right now: hover safely right below the last valid map floor (never sink into void)
            if LastSafeMapPosition then
                local holdPos = Vector3.new(LastSafeMapPosition.X, LastSafeMapPosition.Y + Settings.UnderMapOffset, LastSafeMapPosition.Z)
                myRoot.CFrame = CFrame.new(holdPos) * ProneAngles
                myRoot.AssemblyLinearVelocity = Vector3.zero
            end
            return
        end

        -- Noclip + Anti-Gravity BodyMovers so character never drifts into the void
        for _, part in ipairs(myChar:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
        hum.PlatformStand = true
        for _, track in ipairs(hum:GetPlayingAnimationTracks()) do track:Stop() end

        local bv = myRoot:FindFirstChild("HarmonyFarmBV")
        if not bv then
            bv = Instance.new("BodyVelocity")
            bv.Name = "HarmonyFarmBV"
            bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
            bv.Velocity = Vector3.zero
            bv.Parent = myRoot
        end

        local bg = myRoot:FindFirstChild("HarmonyFarmBG")
        if not bg then
            bg = Instance.new("BodyGyro")
            bg.Name = "HarmonyFarmBG"
            bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
            bg.P = 9e4
            bg.CFrame = ProneAngles
            bg.Parent = myRoot
        end

        LastSafeMapPosition = targetPart.Position
        local goalUnderPos = Vector3.new(targetPart.Position.X, targetPart.Position.Y + Settings.UnderMapOffset, targetPart.Position.Z)
        local currentPos = myRoot.Position

        -- If the player is still far away (e.g. just spawned), snap under the map floor first
        local flatDist = (Vector3.new(goalUnderPos.X, 0, goalUnderPos.Z) - Vector3.new(currentPos.X, 0, currentPos.Z)).Magnitude
        if flatDist > 180 then
            myRoot.CFrame = CFrame.new(goalUnderPos) * ProneAngles
            return
        end

        -- Move smoothly at exact Settings.FarmSpeed (studs/sec) at the coin's under-map Y level
        local alignedStart = Vector3.new(currentPos.X, goalUnderPos.Y, currentPos.Z)
        local stepDist = Settings.FarmSpeed * dt

        if flatDist <= math.max(stepDist * 1.5, 1.8) then
            -- Reached the coin: touch it from slightly underneath while staying prone
            local touchCFrame = CFrame.new(targetPart.Position.X, targetPart.Position.Y - 0.6, targetPart.Position.Z) * ProneAngles
            myRoot.CFrame = touchCFrame
            if firetouchinterest then
                pcall(function()
                    firetouchinterest(myRoot, targetPart, 0)
                    firetouchinterest(myRoot, targetPart, 1)
                end)
            end
            CollectedCoins[targetObj] = true
        else
            local dir = (goalUnderPos - alignedStart).Unit
            local nextPos = alignedStart + (dir * stepDist)
            myRoot.CFrame = CFrame.new(nextPos) * ProneAngles
        end
    end
end)

