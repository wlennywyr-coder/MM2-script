			local intervalMinutes = math.max(1, tonumber(Config.WebhookMinutes) or 5)
			local intervalSeconds = intervalMinutes * 60
			local elapsed = os.clock() - Runtime.LastWebhookSend
			local remaining = math.max(0, math.floor(intervalSeconds - elapsed))

			if WebhookStatusLabel then
