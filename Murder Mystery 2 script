	local function UpdateToggleVisuals()
		TweenService:Create(pill, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			BackgroundColor3 = state and Theme.ToggleOn or Theme.ToggleOff
		}):Play()
