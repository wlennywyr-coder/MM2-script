		btnData.Stroke.Transparency = isSelected and 0 or 1
		btnData.Label.TextColor3 = isSelected and selectedTextCol or Theme.TextSecondary
		btnData.Icon.TextColor3 = isSelected and selectedTextCol or Theme.Accent
	end
end

local function SwitchTab(tabName)
	CurrentActiveTabName = tabName
	ActiveTabTitle.Text = tabName
	for name, page in pairs(Tabs) do
