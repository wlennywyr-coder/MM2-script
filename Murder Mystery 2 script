-- ============================================================================
-- ZERO-LAG CACHED COIN SELECTION & SMOOTH UNDER-MAP GLIDE
-- ============================================================================
local function GetCoinBasePart(obj)
    if obj:IsA("BasePart") then return obj end
    if obj:IsA("Model") then
        return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
    end
    return nil
end

local function IsCoinCollectible(coinObj)
    if not coinObj or not coinObj.Parent then return false end
    local expTime = CollectedCoins[coinObj]
    if expTime and os.clock() < expTime then return false end

    local part = GetCoinBasePart(coinObj)
    if not part then return false end

    local visual = coinObj:FindFirstChild("CoinVisual")
    if visual and visual:IsA("BasePart") and visual.Transparency >= 0.95 then
        return false
    end
    if part.Transparency >= 0.95 and not visual then
        return false
    end
    return true
end

local function GetNearestCachedCoin()
    local myRoot = GetRootPart(LocalPlayer)
    if not myRoot or not CachedCoinContainer or not CachedCoinContainer.Parent then
        return nil, nil
    end

    local bestPart, bestObj = nil, nil
    local minDist = math.huge
    local myPos = myRoot.Position

    for _, child in ipairs(CachedCoinContainer:GetChildren()) do
        if IsCoinCollectible(child) then
            local part = GetCoinBasePart(child)
            if part then
                local d = (part.Position - myPos).Magnitude
                if d < minDist then
                    minDist = d
                    bestPart = part
                    bestObj = child
                end
            end
        end
    end
    return bestPart, bestObj
end

local ProneAngles = CFrame.Angles(math.rad(90), 0, 0)

-- Stepped Loop: Enforces Noclip during Autofarm & Solid Collision during Lobby-to-Map Fling
RunService.Stepped:Connect(function()
    local myChar = GetCharacter(LocalPlayer)
    local hum = GetHumanoid(LocalPlayer)
    if not myChar then return end

    local isFlinging = Settings.FlingTarget or Settings.FlingMurderer or Settings.FlingSheriff
    local isFarming = (Settings.AutoFarmCoins or Settings.AutoFarmEvents) and (CachedCoinContainer ~= nil) and not CachedBagIsFull

    if isFlinging then
        -- Force core body parts to collide with the target player even when teleporting from lobby
        for _, part in ipairs(myChar:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = (part.Name == "HumanoidRootPart" or part.Name == "Torso" or part.Name == "UpperTorso" or part.Name == "LowerTorso")
            end
        end
    elseif isFarming then
        for _, part in ipairs(myChar:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
        if hum then
            hum.PlatformStand = true
            for _, track in ipairs(hum:GetPlayingAnimationTracks()) do
                track:Stop()
            end
        end
    end
end)

-- Heartbeat Loop: Smooth Under-Map Glide & High-Impulse Lobby-to-Map WalkFling
RunService.Heartbeat:Connect(function(dt)
    local myChar = GetCharacter(LocalPlayer)
    local myRoot = GetRootPart(LocalPlayer)
    local hum = GetHumanoid(LocalPlayer)
    if not (myChar and myRoot and hum and hum.Health > 0) then return end

    -- 1. LOBBY-TO-MAP FLING ENGINE
    local flingSubject = nil
    if Settings.FlingTarget and Settings.SelectedTarget then
        flingSubject = Settings.SelectedTarget
    elseif Settings.FlingMurderer then
        flingSubject = FindMurderer()
    elseif Settings.FlingSheriff then
        flingSubject = FindSheriff()
    end

    if flingSubject then
        local targetRoot = GetRootPart(flingSubject)
        local targetHum = GetHumanoid(flingSubject)
        if targetRoot and (not targetHum or targetHum.Health > 0) then
            hum.PlatformStand = false
            -- Oscillate right through the target's HumanoidRootPart and transfer massive linear & rotational momentum
            local osc = math.sin(os.clock() * 55) * 1.4
            local targetPos = targetRoot.Position + (targetRoot.AssemblyLinearVelocity * 0.08) + Vector3.new(osc, 0, -osc)

            myRoot.CFrame = CFrame.new(targetPos) * CFrame.Angles(math.rad(math.random(1, 360)), math.rad(math.random(1, 360)), math.rad(math.random(1, 360)))
            myRoot.AssemblyLinearVelocity = Vector3.new(150000, 150000, 150000)
            myRoot.AssemblyAngularVelocity = Vector3.new(150000, 150000, 150000)
            return
        end
    end

    -- 2. SMOOTH CAMOUFLAGED UNDER-MAP AUTOFARM (NO VERTICAL JERKING, NO LAG)
    if Settings.AutoFarmCoins or Settings.AutoFarmEvents then
        if not CachedCoinContainer or not CachedCoinContainer.Parent or CachedBagIsFull then
            if myRoot:FindFirstChild("HarmonyFarmBV") then
                CleanFarmPhysics()
            end
            return
        end

        -- Save initial map surface position once when starting farm inside the round
        if not SavedMapReturnCFrame then
            SavedMapReturnCFrame = FindMapSafeSurfacePos() or CFrame.new(myRoot.Position + Vector3.new(0, 4, 0))
        end

        local bv = myRoot:FindFirstChild("HarmonyFarmBV")
        if not bv then
            bv = Instance.new("BodyVelocity")
            bv.Name = "HarmonyFarmBV"
            bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
            bv.Velocity = Vector3.zero
            bv.Parent = myRoot
        end

        local bg = myRoot:FindFirstChild("HarmonyFarmBG")
        if not bg then
            bg = Instance.new("BodyGyro")
            bg.Name = "HarmonyFarmBG"
            bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
            bg.P = 9e4
            bg.CFrame = ProneAngles
            bg.Parent = myRoot
        end

        local targetPart, targetObj = GetNearestCachedCoin()
        if not targetPart then
            myRoot.AssemblyLinearVelocity = Vector3.zero
            return
        end

        -- Stay at a constant camouflaged depth underneath the coin (Settings.UnderMapDepth = -2.6)
        local goalUnderPos = Vector3.new(targetPart.Position.X, targetPart.Position.Y + Settings.UnderMapDepth, targetPart.Position.Z)
        local currentPos = myRoot.Position
        local deltaVec = goalUnderPos - currentPos
        local dist3D = deltaVec.Magnitude

        -- If spawning far away, snap directly under the first coin
        if dist3D > 190 then
            myRoot.CFrame = CFrame.new(goalUnderPos) * ProneAngles
            return
        end

        local stepDist = Settings.FarmSpeed * dt
        if dist3D <= math.max(stepDist * 1.4, 2.2) then
            -- Glide smoothly right under the coin without jumping up, and trigger touch interest remotely
            myRoot.CFrame = CFrame.new(goalUnderPos) * ProneAngles
            if firetouchinterest then
                pcall(function()
                    firetouchinterest(myRoot, targetPart, 0)
                    firetouchinterest(myRoot, targetPart, 1)
                end)
            else
                -- Fallback if executor lacks firetouchinterest: subtle 1.1 stud proximity still hidden in floor
                myRoot.CFrame = CFrame.new(targetPart.Position.X, targetPart.Position.Y - 1.4, targetPart.Position.Z) * ProneAngles
            end
            -- Cooldown this coin for 3 seconds so the character immediately glides to the next coin
            CollectedCoins[targetObj] = os.clock() + 3.0
        else
            local nextPos = currentPos + (deltaVec.Unit * stepDist)
            myRoot.CFrame = CFrame.new(nextPos) * ProneAngles
        end
    end
end)

-- ============================================================================
-- VISUALS, PRE-GAME ROLE BANNER & COMBAT RENDER LOOP (ZERO GETDESCENDANTS)
-- ============================================================================
RunService.RenderStepped:Connect(function()
    local myChar = GetCharacter(LocalPlayer)
    local myRoot = GetRootPart(LocalPlayer)

    -- Stabilize velocity on RenderStepped during Fling so Roblox server replicates impact without void-killing you
    if Settings.FlingTarget or Settings.FlingMurderer or Settings.FlingSheriff then
        if myRoot then
            myRoot.AssemblyLinearVelocity = Vector3.zero
        end
    end

    -- Update Pre-Round Role Banner in TopBar
    local murdPlayer = FindMurderer()
    local sherPlayer = FindSheriff()
    RoleBanner.Text = string.format(
        "Murderer: %s  |  Sheriff: %s",
        murdPlayer and murdPlayer.Name or "Waiting...",
        sherPlayer and sherPlayer.Name or "Waiting..."
    )

    -- Spectate Target
    if Settings.SpectateTarget and Settings.SelectedTarget then
        local tHum = GetHumanoid(Settings.SelectedTarget)
        if tHum then Camera.CameraSubject = tHum end
    end

    -- Loop Go To Target
    if Settings.LoopGoToTarget and Settings.SelectedTarget and myRoot then
        local tRoot = GetRootPart(Settings.SelectedTarget)
        if tRoot then myRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0, 3) end
    end

    -- Knife Aura / Auto Kill All
    if GetPlayerRole(LocalPlayer) == "Murderer" and myRoot then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                local pRoot = GetRootPart(p)
                if pRoot then
                    local dist = (pRoot.Position - myRoot.Position).Magnitude
                    if Settings.AutoKillAll or dist <= Settings.AuraDistance then
                        pRoot.CFrame = myRoot.CFrame * CFrame.new(0, 0, -1.8)
                    end
                end
            end
        end
    end

    -- Sheriff Combat (Blatant Kill & Auto Shoot)
    if murdPlayer and myRoot then
        local murdRoot = GetRootPart(murdPlayer)
        if murdRoot then
            if Settings.KillMurdererBlatant then
                myRoot.CFrame = murdRoot.CFrame * CFrame.new(0, 0, 5)
                ShootMurdererNow()
            elseif Settings.AutoShootMurderer then
                local params = RaycastParams.new()
                params.FilterDescendantsInstances = {myChar}
                params.FilterType = Enum.RaycastFilterType.Exclude
                local ray = Workspace:Raycast(myRoot.Position, murdRoot.Position - myRoot.Position, params)
                if ray and ray.Instance and ray.Instance:IsDescendantOf(murdPlayer.Character) then
                    ShootMurdererNow()
                end
            end
        end
    end

    -- Player Chams & Name ESP (Sheriff in Dark Blue #1D4ED8)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local char = p.Character
            local role = GetPlayerRole(p)
            local roleColor = Theme.InnocentESP
            if role == "Murderer" then
                roleColor = Theme.MurdererESP
            elseif role == "Sheriff" then
                roleColor = Theme.SheriffESP
            end

            local hl = char:FindFirstChild("HarmonyCham")
            if Settings.PlayerChams then
                if not hl then
                    hl = Instance.new("Highlight")
                    hl.Name = "HarmonyCham"
                    hl.FillTransparency = 0.4
                    hl.OutlineTransparency = 0.05
                    hl.Parent = char
                end
                hl.FillColor = roleColor
                hl.OutlineColor = roleColor
            elseif hl then
                hl:Destroy()
            end

            local head = char:FindFirstChild("Head")
            if head then
                local bGui = head:FindFirstChild("HarmonyNameESP")
                if Settings.NameESP then
                    if not bGui then
                        bGui = Instance.new("BillboardGui")
                        bGui.Name = "HarmonyNameESP"
                        bGui.Size = UDim2.new(0, 150, 0, 28)
                        bGui.StudsOffset = Vector3.new(0, 2.6, 0)
                        bGui.AlwaysOnTop = true
                        bGui.Parent = head

                        local tag = Instance.new("TextLabel")
                        tag.Name = "Tag"
                        tag.Size = UDim2.new(1, 0, 1, 0)
                        tag.BackgroundTransparency = 1
                        tag.Font = Enum.Font.GothamBold
                        tag.TextSize = 12
                        tag.TextStrokeTransparency = 0.25
                        tag.Parent = bGui
                    end
                    bGui.Tag.Text = string.format("%s [%s]", p.Name, role)
                    bGui.Tag.TextColor3 = roleColor
                elseif bGui then
                    bGui:Destroy()
                end
            end
        end
    end

    -- Cached Gun Drop Cham (Zero GetDescendants lag)
    if CachedGunDrop and CachedGunDrop.Parent then
        local gCham = CachedGunDrop:FindFirstChild("HarmonyGunCham")
        if Settings.GunCham then
            if not gCham then
                gCham = Instance.new("Highlight")
                gCham.Name = "HarmonyGunCham"
                gCham.FillColor = Theme.Accent
                gCham.OutlineColor = Theme.TextPrimary
                gCham.FillTransparency = 0.25
                gCham.Parent = CachedGunDrop
            end
        elseif gCham then
            gCham:Destroy()
        end
    end
end)

