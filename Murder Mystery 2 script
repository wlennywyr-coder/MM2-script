local function GetCharacter(player) return player and player.Character end
local function GetRootPart(player) return player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") end
local function GetHumanoid(player) return player and player.Character and player.Character:FindFirstChildOfClass("Humanoid") end
local function HasItem(player, itemName)
    if not player then return false end
    local bp = player:FindFirstChild("Backpack")
    local char = GetCharacter(player)
    if bp and bp:FindFirstChild(itemName) then return true end
    if char and char:FindFirstChild(itemName) then return true end
    return false
end

local function IsPlayerInActiveMap(player)
    local root = GetRootPart(player)
    if not root or not CachedCoinContainer or not CachedCoinContainer.Parent then return false end
    if CachedDeadPlayers[player.Name] then return false end

    local refPos = nil
    local firstCoin = CachedCoinContainer:FindFirstChildWhichIsA("BasePart", true)
    if firstCoin then refPos = firstCoin.Position
    elseif CachedCoinContainer.Parent:IsA("Model") and CachedCoinContainer.Parent.PrimaryPart then refPos = CachedCoinContainer.Parent.PrimaryPart.Position
    else
        local anyPart = CachedCoinContainer.Parent:FindFirstChildWhichIsA("BasePart", true)
        if anyPart then refPos = anyPart.Position end
    end

    if not refPos then return false end
    local flatDist = (Vector3.new(root.Position.X, 0, root.Position.Z) - Vector3.new(refPos.X, 0, refPos.Z)).Magnitude
    return flatDist < 250
end

local function GetPlayerRole(player)
    if not player then return "Innocent" end
    if HasItem(player, "Knife") then return "Murderer" end
    if HasItem(player, "Gun") or HasItem(player, "Revolver") then return "Sheriff" end
    if RoundIsActive and not CachedDeadPlayers[player.Name] then
        local cached = CachedRoles[player.Name]
        if cached == "Murderer" then return "Murderer"
        elseif cached == "Sheriff" or cached == "Hero" then return "Sheriff" end
    end
    return "Innocent"
end

local function FindMurderer()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and GetPlayerRole(p) == "Murderer" then return p end
    end
    return nil
end

local function FindSheriff()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and GetPlayerRole(p) == "Sheriff" then return p end
    end
    return nil
end

local function ForceStandUpright()
    local root = GetRootPart(LocalPlayer)
    local hum = GetHumanoid(LocalPlayer)
    local char = GetCharacter(LocalPlayer)
    if root then
        local bv = root:FindFirstChild("HarmonyFarmBV")
        if bv then bv:Destroy() end
        local bg = root:FindFirstChild("HarmonyFarmBG")
        if bg then bg:Destroy() end
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        local _, yYaw, _ = root.CFrame:ToEulerAnglesYXZ()
        local lookFlat = root.CFrame.LookVector
        if math.abs(lookFlat.Y) > 0.5 then
            root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, yYaw, 0)
        end
    end
    if hum then
        hum.PlatformStand = false
        if hum:GetState() == Enum.HumanoidStateType.PlatformStanding then hum:ChangeState(Enum.HumanoidStateType.GettingUp) end
    end
    if char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = true end
        end
    end
end

