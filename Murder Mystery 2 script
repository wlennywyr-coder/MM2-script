-- ============================================================================
-- FONCTIONS UTILITAIRES MM2
-- ============================================================================
local function GetCharacter(player)
    return player and player.Character
end

local function GetRootPart(player)
    local char = GetCharacter(player)
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function GetHumanoid(player)
    local char = GetCharacter(player)
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function HasItem(player, itemName)
    if not player then return false end
    local backpack = player:FindFirstChild("Backpack")
    local char = GetCharacter(player)
    if backpack and backpack:FindFirstChild(itemName) then return true end
    if char and char:FindFirstChild(itemName) then return true end
    return false
end

local function GetPlayerRole(player)
    if HasItem(player, "Knife") then
        return "Murderer"
    elseif HasItem(player, "Gun") or HasItem(player, "Revolver") then
        return "Sheriff"
    end
    return "Innocent"
end

local function FindMurderer()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and GetPlayerRole(p) == "Murderer" then
            return p
        end
    end
    return nil
end

local function FindSheriff()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and GetPlayerRole(p) == "Sheriff" then
            return p
        end
    end
    return nil
end

local function RestoreCharacter()
    local hum = GetHumanoid(LocalPlayer)
    local root = GetRootPart(LocalPlayer)
    if hum then
        hum.PlatformStand = false
        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
    end
    if root then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        if PreFlingCFrame then
            root.CFrame = PreFlingCFrame
            PreFlingCFrame = nil
        else
            root.CFrame = CFrame.new(root.Position + Vector3.new(0, 6, 0))
        end
    end
end

