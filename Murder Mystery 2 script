end

local function DirectFireGun(gunTool, targetPos)
    if not gunTool or not targetPos then return end
    
    -- Method 1: CreateBeam Remote
    local createBeam = gunTool:FindFirstChild("CreateBeam", true)
    local beamRemote = createBeam and createBeam:FindFirstChildOfClass("RemoteFunction")
    if beamRemote then
        task.spawn(function() pcall(function() beamRemote:InvokeServer(1, targetPos, "AH2") end) end)
    end
    
    -- Method 2: ShootGun Remote
    local knifeServer = gunTool:FindFirstChild("KnifeServer")
    local shootGun = knifeServer and knifeServer:FindFirstChild("ShootGun")
    if shootGun and shootGun:IsA("RemoteFunction") then
        task.spawn(function() pcall(function() shootGun:InvokeServer(1, targetPos, "AH2") end) end)
    end
end

local function DisableKnifeLocal()
    local char = GetCharacter(LocalPlayer)
    if not char then return end
    local gun = char:FindFirstChild("Gun") or char:FindFirstChild("Revolver")
    if gun then
        local kLocal = gun:FindFirstChild("KnifeLocal") or gun:FindFirstChild("GunLocal")
        if kLocal and kLocal:IsA("LocalScript") then
            kLocal.Disabled = Settings.SilentAim
        end
    end
end

