-- ============================================================================
-- AUTOFARM LOGIC (GLISSEMENT FLUIDE)
-- ============================================================================
local function GetNearestSafeCoin()
    local myRoot = GetRootPart(LocalPlayer)
    if not CachedCoinContainer or not myRoot then return nil end
    local murderer = FindMurderer()
    local murdRoot = murderer and GetRootPart(murderer)

    local bestPart = nil
    local bestScore = -math.huge
    local fallbackPart = nil

    for _, c in ipairs(CachedCoinContainer:GetChildren()) do
        local part = c:IsA("BasePart") and c or c:FindFirstChildWhichIsA("BasePart")
        if part and part.Transparency < 0.9 then
            local distMe = (part.Position - myRoot.Position).Magnitude
            if murdRoot and Settings.AvoidMurdererFarm then
                local distMurd = (part.Position - murdRoot.Position).Magnitude
                if distMurd > 35 then
                    local score = (distMurd * 2) - distMe
                    if score > bestScore then bestScore = score bestPart = part end
                end
                fallbackPart = part
            else
                local score = -distMe
                if score > bestScore then bestScore = score bestPart = part end
            end
        end
    end
    return bestPart or fallbackPart
end

RunService.Heartbeat:Connect(function(dt)
    local myChar = GetCharacter(LocalPlayer)
    local myRoot = GetRootPart(LocalPlayer)
    local hum = GetHumanoid(LocalPlayer)
    if not myChar or not myRoot or not hum then return end

    -- NOUVEAU FLING PHYSIQUE INTENSIF
    local fSubj = nil
    if Settings.FlingMurderer then fSubj = FindMurderer()
    elseif Settings.FlingSheriff then fSubj = FindSheriff() end

    if fSubj then
        local tRoot = GetRootPart(fSubj)
        if tRoot then
            hum.PlatformStand = true
            myRoot.CFrame = tRoot.CFrame
            myRoot.Velocity = Vector3.new(50000, 50000, 50000)
            myRoot.RotVelocity = Vector3.new(50000, 50000, 50000)
            return
        end
    end

    -- AUTOFARM FLUIDE (Zéro TP)
    if (Settings.AutoFarmCoins or Settings.AutoFarmEvents) and not CachedBagIsFull and IsPlayerInActiveMap(LocalPlayer) then
        local targetCoin = GetNearestSafeCoin()
        if not targetCoin then return end

        local goalPos = Vector3.new(targetCoin.Position.X, targetCoin.Position.Y + Settings.UnderMapDepth, targetCoin.Position.Z)
        local curPos = myRoot.Position
        local dist = (goalPos - curPos).Magnitude

        hum.PlatformStand = true
        for _, part in ipairs(myChar:GetDescendants()) do if part:IsA("BasePart") then part.CanCollide = false end end

        local bv = myRoot:FindFirstChild("HarmonyFarmBV") or Instance.new("BodyVelocity", myRoot)
        bv.Name = "HarmonyFarmBV" bv.MaxForce = Vector3.new(9e9, 9e9, 9e9) bv.Velocity = Vector3.zero
        local bg = myRoot:FindFirstChild("HarmonyFarmBG") or Instance.new("BodyGyro", myRoot)
        bg.Name = "HarmonyFarmBG" bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9) bg.CFrame = CFrame.Angles(math.rad(90), 0, 0)

        local step = Settings.FarmSpeed * dt
        if dist <= step * 1.5 then
            myRoot.CFrame = CFrame.new(goalPos) * CFrame.Angles(math.rad(90), 0, 0)
            if firetouchinterest then
                pcall(function() firetouchinterest(myRoot, targetCoin, 0) firetouchinterest(myRoot, targetCoin, 1) end)
            end
            targetCoin.Transparency = 1 -- Fake collection localement
        else
            myRoot.CFrame = CFrame.new(curPos + (goalPos - curPos).Unit * step) * CFrame.Angles(math.rad(90), 0, 0)
        end
    end
end)

