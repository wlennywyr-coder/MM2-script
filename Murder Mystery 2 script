-- Boucle principale (ESP, Combat, Ciblage)
RunService.RenderStepped:Connect(function()
    local myChar = GetCharacter(LocalPlayer)
    local myRoot = GetRootPart(LocalPlayer)

    -- 1. Spectate Target
    if Settings.SpectateTarget and Settings.SelectedTarget then
        local targetChar = GetCharacter(Settings.SelectedTarget)
        if targetChar and targetChar:FindFirstChildOfClass("Humanoid") then
            Camera.CameraSubject = targetChar:FindFirstChildOfClass("Humanoid")
        end
    end

    -- 2. Loop Go To Target
    if Settings.LoopGoToTarget and Settings.SelectedTarget and myRoot then
        local targetRoot = GetRootPart(Settings.SelectedTarget)
        if targetRoot then
            myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 3)
        end
    end

    -- 3. Fling Target / Fling Sheriff
    local flingSubject = nil
    if Settings.FlingTarget and Settings.SelectedTarget then
        flingSubject = Settings.SelectedTarget
    elseif Settings.FlingSheriff then
        flingSubject = FindSheriff()
    end

    if flingSubject and myRoot then
        local targetRoot = GetRootPart(flingSubject)
        if targetRoot then
            myRoot.CFrame = targetRoot.CFrame
            myRoot.Velocity = Vector3.new(9000, 9000, 9000)
            myRoot.RotVelocity = Vector3.new(9000, 9000, 9000)
        end
    end

    -- 4. Combat Murderer (Knife Aura & Auto Kill All)
    if GetPlayerRole(LocalPlayer) == "Murderer" and myRoot then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                local pRoot = GetRootPart(p)
                if pRoot then
                    local dist = (pRoot.Position - myRoot.Position).Magnitude
                    if Settings.AutoKillAll then
                        pRoot.CFrame = myRoot.CFrame * CFrame.new(0, 0, -2)
                    elseif dist <= Settings.AuraDistance then
                        pRoot.CFrame = myRoot.CFrame * CFrame.new(0, 0, -1.5)
                    end
                end
            end
        end
    end

    -- 5. Combat Shérif (Silent Aim, Kill Murderer Blatant, Auto Shoot)
    local murderer = FindMurderer()
    if murderer and myRoot then
        local murdRoot = GetRootPart(murderer)
        if murdRoot then
            if Settings.KillMurdererBlatant then
                myRoot.CFrame = murdRoot.CFrame * CFrame.new(0, 0, 6)
                ShootAtMurderer()
            elseif Settings.AutoShootMurderer then
                local rayParams = RaycastParams.new()
                rayParams.FilterDescendantsInstances = {myChar}
                rayParams.FilterType = Enum.RaycastFilterType.Exclude
                local ray = Workspace:Raycast(myRoot.Position, (murdRoot.Position - myRoot.Position), rayParams)
                if ray and ray.Instance and ray.Instance:IsDescendantOf(murderer.Character) then
                    ShootAtMurderer()
                end
            elseif Settings.SilentAim and GetPlayerRole(LocalPlayer) == "Sheriff" then
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, murdRoot.Position)
            end
        end
    end

    -- 6. Player Chams & Name ESP
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local char = p.Character
            local role = GetPlayerRole(p)
            local roleColor = Color3.fromHex("#10B981") -- Innocent (Vert)
            if role == "Murderer" then
                roleColor = Color3.fromHex("#EF4444")   -- Murderer (Rouge)
            elseif role == "Sheriff" then
                roleColor = Theme.Cyan                  -- Shérif (Bleu Miku)
            end

            -- Highlight (Player Chams)
            local highlight = char:FindFirstChild("HarmonyCham")
            if Settings.PlayerChams then
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Name = "HarmonyCham"
                    highlight.FillTransparency = 0.45
                    highlight.OutlineTransparency = 0.1
                    highlight.Parent = char
                end
                highlight.FillColor = roleColor
                highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
            elseif highlight then
                highlight:Destroy()
            end

            -- BillboardGui (Name ESP)
            local head = char:FindFirstChild("Head")
            if head then
                local espGui = head:FindFirstChild("HarmonyNameESP")
                if Settings.NameESP then
                    if not espGui then
                        espGui = Instance.new("BillboardGui")
                        espGui.Name = "HarmonyNameESP"
                        espGui.Size = UDim2.new(0, 140, 0, 30)
                        espGui.StudsOffset = Vector3.new(0, 2.5, 0)
                        espGui.AlwaysOnTop = true
                        espGui.Parent = head

                        local nameTag = Instance.new("TextLabel")
                        nameTag.Name = "Tag"
                        nameTag.Size = UDim2.new(1, 0, 1, 0)
                        nameTag.BackgroundTransparency = 1
                        nameTag.Font = Enum.Font.GothamBold
                        nameTag.TextSize = 13
                        nameTag.TextStrokeTransparency = 0.3
                        nameTag.Parent = espGui
                    end
                    espGui.Tag.Text = string.format("%s [%s]", p.Name, role)
                    espGui.Tag.TextColor3 = roleColor
                elseif espGui then
                    espGui:Destroy()
                end
            end
        end
    end

    -- 7. Gun Cham (Surbrillance du pistolet au sol)
    local gunDrop = Workspace:FindFirstChild("GunDrop", true)
    if gunDrop and gunDrop:IsA("BasePart") then
        local gunHighlight = gunDrop:FindFirstChild("HarmonyGunCham")
        if Settings.GunCham then
            if not gunHighlight then
                gunHighlight = Instance.new("Highlight")
                gunHighlight.Name = "HarmonyGunCham"
                gunHighlight.FillColor = Theme.Magenta
                gunHighlight.OutlineColor = Theme.Cyan
                gunHighlight.FillTransparency = 0.25
                gunHighlight.Parent = gunDrop
            end
        elseif gunHighlight then
            gunHighlight:Destroy()
        end
    end
end)
