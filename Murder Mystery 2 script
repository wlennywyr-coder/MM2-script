-- Prédiction ultra-vive : anticipe instantanément les joueurs en mouvement (course + saut)
local function GetMurdererTargetData(murderer)
	local char = GetCharacter(murderer)
	local hrp = GetRootPart(murderer)
	local hum = GetHumanoid(murderer)
	if not char or not hrp then return nil, nil end

	local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or hrp
	local centerMass = (hrp.Position * 0.65) + (torso.Position * 0.35)

	local velocity = hrp.AssemblyLinearVelocity or Vector3.zero
	local ping = 0.065
	pcall(function()
		local netPing = LocalPlayer:GetNetworkPing()
		if type(netPing) == "number" and netPing > 0 then
			ping = math.clamp(netPing, 0.02, 0.22)
		end
	end)

	local horizPhysicsVel = Vector3.new(velocity.X, 0, velocity.Z)
	local walkSpeed = (hum and hum.WalkSpeed and hum.WalkSpeed > 0) and hum.WalkSpeed or 16
	local moveDirVel = (hum and hum.MoveDirection.Magnitude > 0.05)
		and (hum.MoveDirection.Unit * math.max(horizPhysicsVel.Magnitude, walkSpeed))
		or horizPhysicsVel

	local effectiveHorizVel = (horizPhysicsVel * 0.55) + (moveDirVel * 0.45)

	local leadTime = 0.135 + (ping * 0.65)
	local horizOffset = effectiveHorizVel * leadTime
	if horizOffset.Magnitude > 2.85 then
		horizOffset = horizOffset.Unit * 2.85
	end

	local vertOffset = 0
	if math.abs(velocity.Y) > 2 then
		vertOffset = math.clamp(velocity.Y * 0.075, -1.15, 1.45)
	end

	local predictedPos = centerMass + horizOffset + Vector3.new(0, vertOffset, 0)
	local predictedCF = CFrame.new(predictedPos)
	return predictedPos, predictedCF
end

