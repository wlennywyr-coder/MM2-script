-- Optional Metamethod Hook for executors supporting hookmetamethod (Redirects Mouse.Hit & CreateBeam)
pcall(function()
    if hookmetamethod and getnamecallmethod then
        local oldNamecall
        oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
            local method = getnamecallmethod()
            local args = {...}
            if Settings.SilentAim and (method == "InvokeServer" or method == "FireServer") and tostring(self) == "RemoteFunction" then
                if self.Parent and self.Parent.Name == "CreateBeam" then
                    local targetPos = GetPredictedMurdererPos()
                    if targetPos then
                        args[2] = targetPos
                        return oldNamecall(self, unpack(args))
                    end
                end
            end
            return oldNamecall(self, ...)
        end)
    end
end)

