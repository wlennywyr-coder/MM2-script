local function DispatchMM2GunRemotes(gunTool, targetPos, targetCF)
	if not gunTool or not targetPos then return end
	local localHRP = GetRootPart(LocalPlayer)
	local handle = gunTool:FindFirstChild("Handle")
	local originPos = (handle and handle:IsA("BasePart") and handle.Position)
		or (localHRP and localHRP.Position)
		or targetPos

	local originLookCF = CFrame.lookAt(originPos, targetPos)
	local finalTargetCF = targetCF or CFrame.new(targetPos)

	local shootRemote = gunTool:FindFirstChild("Shoot", true)
	if shootRemote then
		task.spawn(function()
			pcall(function()
				if shootRemote:IsA("RemoteEvent") then
					shootRemote:FireServer(originLookCF, finalTargetCF)
				elseif shootRemote:IsA("RemoteFunction") then
					shootRemote:InvokeServer(originLookCF, finalTargetCF)
				end
			end)
		end)
	end

	local createBeam = gunTool:FindFirstChild("CreateBeam", true)
	if createBeam then
		local rf = createBeam:FindFirstChild("RemoteFunction") or createBeam:FindFirstChildWhichIsA("RemoteFunction")
		if rf then
			task.spawn(function()
				pcall(function()
					rf:InvokeServer(1, targetPos, "AH2")
				end)
			end)
		end
	end

	local shootGun = gunTool:FindFirstChild("ShootGun", true)
	if shootGun then
		task.spawn(function()
			pcall(function()
				if shootGun:IsA("RemoteFunction") then
					shootGun:InvokeServer(1, targetPos, "AH2")
				elseif shootGun:IsA("RemoteEvent") then
					shootGun:FireServer(1, targetPos, "AH2")
				end
			end)
		end)
	end
end

local function PerformVertexSheriffShot(useBlatantTeleport, requireAlreadyEquipped)
	if os.clock() - Runtime.ShootCooldown < 0.05 then return end
	if not IsAlive(LocalPlayer) then return end

	local char = GetCharacter(LocalPlayer)
	local hum = GetHumanoid(LocalPlayer)
	local localHRP = GetRootPart(LocalPlayer)
	if not char or not hum or not localHRP then return end

	local gun = GetMM2Tool(LocalPlayer, "Gun")
	if not gun then return end

	if requireAlreadyEquipped and gun.Parent ~= char then
		return
	end

	local murderer = GetMurdererInstant()
	if not murderer or not IsAlive(murderer) then return end

	Runtime.ShootCooldown = os.clock()

	local justEquipped = false
	if gun.Parent ~= char then
		justEquipped = true
		pcall(function()
			hum:EquipTool(gun)
		end)
		if gun.Parent ~= char then
			pcall(function() gun.Parent = char end)
		end
	end

	local savedCFrame = localHRP.CFrame
	if useBlatantTeleport and GetRootPart(murderer) then
		local murdHRP = GetRootPart(murderer)
		local offsetPos = (murdHRP.CFrame * CFrame.new(0, 1.5, 6.5)).Position
		localHRP.CFrame = CFrame.new(offsetPos) * (savedCFrame - savedCFrame.Position)
	end

	local targetPos, targetCF = GetMurdererTargetData(murderer)
	if targetPos then
		DispatchMM2GunRemotes(gun, targetPos, targetCF)
	end

	for _, delayTime in ipairs({0.01, 0.03, 0.06, 0.10, 0.14}) do
		task.delay(delayTime, function()
			if gun and gun.Parent == char then
				local m = GetMurdererInstant()
				if m and IsAlive(m) then
					local p, cf = GetMurdererTargetData(m)
					if p then
						DispatchMM2GunRemotes(gun, p, cf)
					end
				end
			end
		end)
	end

	if useBlatantTeleport then
		task.wait(justEquipped and 0.12 or 0.05)
		if localHRP and localHRP.Parent then
			localHRP.CFrame = savedCFrame
		end
	end
end

local function PerformCameraFlickShot()
	if not IsAlive(LocalPlayer) then return end

	local char = GetCharacter(LocalPlayer)
	local hum = GetHumanoid(LocalPlayer)
	local localHRP = GetRootPart(LocalPlayer)
	local cam = Workspace.CurrentCamera
	if not char or not hum or not localHRP or not cam then return end

	local gun = GetMM2Tool(LocalPlayer, "Gun")
	if not gun then return end

	local targetPlr = GetMurdererInstant()
	if (not targetPlr or targetPlr == LocalPlayer or not IsAlive(targetPlr)) and Runtime.SheriffPlayer and Runtime.SheriffPlayer ~= LocalPlayer and IsAlive(Runtime.SheriffPlayer) then
		targetPlr = Runtime.SheriffPlayer
	end
	if not targetPlr or not IsAlive(targetPlr) then return end

	if gun.Parent ~= char then
		pcall(function()
			hum:EquipTool(gun)
		end)
		if gun.Parent ~= char then
			pcall(function() gun.Parent = char end)
		end
	end

	local originalCamCF = cam.CFrame

	local flickConn
	flickConn = RunService.RenderStepped:Connect(function()
		if targetPlr and IsAlive(targetPlr) and cam then
			local tPos = GetMurdererTargetData(targetPlr)
			if tPos then
				cam.CFrame = CFrame.lookAt(cam.CFrame.Position, tPos)
			end
		end
	end)

	local targetPos, targetCF = GetMurdererTargetData(targetPlr)
	if targetPos then
		localHRP.CFrame = CFrame.lookAt(localHRP.Position, Vector3.new(targetPos.X, localHRP.Position.Y, targetPos.Z))
		cam.CFrame = CFrame.lookAt(cam.CFrame.Position, targetPos)
		DispatchMM2GunRemotes(gun, targetPos, targetCF)
		pcall(function()
			gun:Activate()
		end)
	end

	for _, delayTime in ipairs({0.015, 0.035, 0.06}) do
		task.delay(delayTime, function()
			if gun and gun.Parent == char and targetPlr and IsAlive(targetPlr) then
				local p, cf = GetMurdererTargetData(targetPlr)
				if p then
					DispatchMM2GunRemotes(gun, p, cf)
				end
			end
		end)
	end

	task.delay(0.075, function()
		if flickConn then
			pcall(function() flickConn:Disconnect() end)
		end
		if cam then
			cam.CFrame = originalCamCF
		end
	end)
end

