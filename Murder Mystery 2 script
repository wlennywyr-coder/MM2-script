-- Metamethod Hooks (__namecall & __index) for True Silent Aim
pcall(function()
    if hookmetamethod and getnamecallmethod and not getgenv().HarmonySilentAimHooked then
        getgenv().HarmonySilentAimHooked = true

        local oldNamecall
        oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
            local method = getnamecallmethod()
            if Settings.SilentAim and (method == "InvokeServer" or method == "FireServer") then
                local name = tostring(self)
                if name == "ShootGun" or name == "RemoteFunction" or (self.Parent and (self.Parent.Name == "CreateBeam" or self.Parent.Name == "KnifeServer")) then
                    local targetPos = GetPredictedMurdererPosition()
                    if targetPos then
                        local args = {...}
                        for i, v in ipairs(args) do
                            if typeof(v) == "Vector3" then
                                args[i] = targetPos
                            elseif typeof(v) == "CFrame" then
                                args[i] = CFrame.new(targetPos)
                            end
                        end
                        return oldNamecall(self, unpack(args))
                    end
                end
            end
            return oldNamecall(self, ...)
        end)

        local oldIndex
        oldIndex = hookmetamethod(game, "__index", function(self, key)
            if Settings.SilentAim and self == Mouse and (key == "Hit" or key == "Target") then
                local myChar = LocalPlayer.Character
                if myChar and (myChar:FindFirstChild("Gun") or myChar:FindFirstChild("Revolver")) then
                    local murderer = FindMurderer()
                    local murdRoot = GetRootPart(murderer)
                    if murdRoot then
                        if key == "Hit" then
                            return CFrame.new(murdRoot.Position + (murdRoot.AssemblyLinearVelocity * 0.12))
                        elseif key == "Target" then
                            return murdRoot
                        end
                    end
                end
            end
            return oldIndex(self, key)
        end)
    end
end)

