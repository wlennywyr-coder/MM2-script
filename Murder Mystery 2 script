local function GetPredictedMurdererPosition()
    local murderer = FindMurderer()
    if not murderer or not murderer.Character then return nil end
    local murdRoot = murderer.Character:FindFirstChild("HumanoidRootPart")
    if murdRoot then return murdRoot.Position + (murdRoot.AssemblyLinearVelocity * 0.12) end
