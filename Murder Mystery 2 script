-- RENDERSTEPPED (COMBAT AUTO & VISUELS)
-- ============================================================================
RunService.RenderStepped:Connect(function()
    local myRoot = GetRootPart(LocalPlayer)

    -- Auto Grab Gun (Déplace le pistolet vers toi localement)
    if Settings.AutoGrabGun and myRoot then
        local gunDrop = Workspace:FindFirstChild("GunDrop", true)
        if gunDrop and gunDrop:IsA("BasePart") then
            gunDrop.CFrame = myRoot.CFrame
        end
    end

    -- Auto Shoot
    if Settings.AutoShootMurderer then
        local murd = FindMurderer()
        if murd and myRoot then
            local mRoot = GetRootPart(murd)
            if mRoot then
                local ray = Workspace:Raycast(myRoot.Position, mRoot.Position - myRoot.Position)
                if ray and ray.Instance:IsDescendantOf(murd.Character) then
                    ShootMurdererMacro()
                end
            end
        end
    end

    -- Aura & Auto Kill All Immobile
    if Settings.AutoKillAll and HasItem(LocalPlayer, "Knife") then
        ExecuteImmobileKillAll()
    elseif Settings.AuraDistance > 5 and HasItem(LocalPlayer, "Knife") and myRoot then
        local knife = GetCharacter(LocalPlayer):FindFirstChild("Knife")
        if knife and knife:FindFirstChild("Handle") then
            for _, p in ipairs(Players:GetPlayers()) do
                local tRoot = GetRootPart(p)
                if tRoot and p ~= LocalPlayer and (tRoot.Position - myRoot.Position).Magnitude <= Settings.AuraDistance then
                    local oldCF = tRoot.CFrame
                    tRoot.CFrame = myRoot.CFrame * CFrame.new(0, 0, -2)
                    RunService.Heartbeat:Wait()
                    if tRoot.Parent then tRoot.CFrame = oldCF end
                end
            end
        end
    end

    -- Player ESP Basique
    if Settings.PlayerChams then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local role = GetPlayerRole(p)
                local col = Theme.InnocentESP
                if role == "Murderer" then col = Theme.MurdererESP elseif role == "Sheriff" then col = Theme.SheriffESP end
                local hl = p.Character:FindFirstChild("HHL") or Instance.new("Highlight", p.Character)
                hl.Name = "HHL" hl.FillColor = col hl.OutlineColor = col hl.FillTransparency = 0.4
            end
        end
    else
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character and p.Character:FindFirstChild("HHL") then p.Character.HHL:Destroy() end
        end
    end
end)
