-- BACKGROUND CACHE SCANNER (RUNS EVERY 0.8s TO PREVENT ANY FRAME LAG)
-- ============================================================================
local function CheckIfBagFullUI()
    local pGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not pGui then return false end

    for _, desc in ipairs(pGui:GetDescendants()) do
        if desc:IsA("TextLabel") and desc.Visible then
            local txt = string.lower(desc.Text)
            if txt == "full" or txt == "full!" or string.find(txt, "bag full") then
                return true
            end
            local cur, max = string.match(txt, "^(%d+)%s*/%s*(%d+)$")
            if cur and max then
                local nCur, nMax = tonumber(cur), tonumber(max)
                if nCur and nMax and nMax >= 10 and nCur >= nMax then
                    return true
                end
            end
        end
    end
    return false
end

local function FindMapSafeSurfacePos()
    if CachedCoinContainer and CachedCoinContainer.Parent then
        local mapModel = CachedCoinContainer.Parent
        local spawns = mapModel:FindFirstChild("Spawns") or mapModel:FindFirstChild("PlayerSpawns")
        if spawns then
            local firstSpawn = spawns:FindFirstChildWhichIsA("BasePart", true)
            if firstSpawn then
                return firstSpawn.CFrame + Vector3.new(0, 4, 0)
            end
        end
        for _, child in ipairs(CachedCoinContainer:GetChildren()) do
            local part = child:IsA("BasePart") and child or child:FindFirstChildWhichIsA("BasePart")
            if part then
                return CFrame.new(part.Position + Vector3.new(0, 4.5, 0))
            end
        end
    end
    return nil
end

local function CleanFarmPhysics()
    local root = GetRootPart(LocalPlayer)
    local hum = GetHumanoid(LocalPlayer)
    if root then
        local bv = root:FindFirstChild("HarmonyFarmBV")
        if bv then bv:Destroy() end
        local bg = root:FindFirstChild("HarmonyFarmBG")
        if bg then bg:Destroy() end
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
    if hum then
        hum.PlatformStand = false
        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
    end
    local char = GetCharacter(LocalPlayer)
    if char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and (part.Name == "HumanoidRootPart" or part.Name == "Torso" or part.Name == "UpperTorso" or part.Name == "LowerTorso") then
                part.CanCollide = true
            end
        end
    end
end

local function RestorePlayerToMap()
    CleanFarmPhysics()
    local root = GetRootPart(LocalPlayer)
    if not root then return end

    local mapSurface = FindMapSafeSurfacePos()
    if SavedMapReturnCFrame and CachedCoinContainer and CachedCoinContainer.Parent then
        root.CFrame = SavedMapReturnCFrame
    elseif mapSurface then
        root.CFrame = mapSurface
    else
        root.CFrame = CFrame.new(root.Position.X, root.Position.Y + 6, root.Position.Z)
    end
    SavedMapReturnCFrame = nil
end

-- Asynchronous Scanner Loop (0 Lag)
task.spawn(function()
    while task.wait(0.75) do
        -- 1. Pre-Round Role Detection via GetPlayerData
        pcall(function()
            local getPlayerData = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
            if getPlayerData and getPlayerData:IsA("RemoteFunction") then
                local data = getPlayerData:InvokeServer()
                if type(data) == "table" then
                    for playerName, info in pairs(data) do
                        if type(info) == "table" and info.Role then
                            CachedRoles[playerName] = info.Role
                        end
                    end
                end
            end
        end)

        -- 2. Cache Active Map CoinContainer & GunDrop without lagging RenderStepped
        local foundContainer = nil
        local foundGun = nil
        for _, child in ipairs(Workspace:GetChildren()) do
            if child:IsA("Model") and child ~= LocalPlayer.Character then
                local cc = child:FindFirstChild("CoinContainer")
                if cc and #cc:GetChildren() > 0 then
                    foundContainer = cc
                end
                local gd = child:FindFirstChild("GunDrop")
                if gd and gd:IsA("BasePart") then
                    foundGun = gd
                end
            elseif child.Name == "GunDrop" and child:IsA("BasePart") then
                foundGun = child
            end
        end
        if not foundContainer then
            foundContainer = Workspace:FindFirstChild("CoinContainer", true)
        end
        if not foundGun then
            foundGun = Workspace:FindFirstChild("GunDrop", true)
        end

        -- Reset round state if map changed or ended
        if foundContainer ~= CachedCoinContainer then
            table.clear(CollectedCoins)
            BagFullHandledThisRound = false
            SavedMapReturnCFrame = nil
        end
        CachedCoinContainer = foundContainer
        CachedGunDrop = foundGun

        -- 3. Independent Bag Full Check (works even if Autofarm is OFF!)
        CachedBagIsFull = (CachedCoinContainer ~= nil) and CheckIfBagFullUI()
        if CachedBagIsFull and not BagFullHandledThisRound then
            BagFullHandledThisRound = true
            if Settings.AutoResetAfterFarm then
                CleanFarmPhysics()
                local char = GetCharacter(LocalPlayer)
                local hum = GetHumanoid(LocalPlayer)
                if hum then hum.Health = 0 end
                if char then char:BreakJoints() end
            elseif Settings.AutoFarmCoins or Settings.AutoFarmEvents then
                RestorePlayerToMap()
            end
        end
    end
end)

