					Size = UDim2.new(1, 0, 0, 38)
				}):Play()
				if callback then
					task.spawn(callback, selected)
				end
				SaveCurrentConfig()
				RebuildOptions(currentOptions)
			end)
		end

		local totalListHeight = #currentOptions * 28
		listFrame.Size = UDim2.new(1, 0, 0, totalListHeight)
		if isOpen then
			container.Size = UDim2.new(1, 0, 0, 42 + totalListHeight)
