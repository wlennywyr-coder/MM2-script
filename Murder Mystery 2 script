local function GetCharacter(plr)
	plr = plr or LocalPlayer
	return plr and plr.Character
end

local function GetRootPart(plr)
	local char = GetCharacter(plr)
	return char and char:FindFirstChild("HumanoidRootPart")
end

local function GetHumanoid(plr)
	local char = GetCharacter(plr)
	return char and char:FindFirstChildOfClass("Humanoid")
end

local function IsAlive(plr)
	local hum = GetHumanoid(plr)
	local hrp = GetRootPart(plr)
	return hum and hrp and hum.Health > 0
end

local function GetMM2Tool(plr, weaponType)
	if not plr then return nil end

	local function SearchContainer(container)
		if not container then return nil end
		for _, item in ipairs(container:GetChildren()) do
			if item:IsA("Tool") then
				if weaponType == "Gun" then
					if item.Name == "Gun"
						or item.Name == "Revolver"
						or item:FindFirstChild("Shoot", true)
						or item:FindFirstChild("CreateBeam", true)
						or item:FindFirstChild("ShootGun", true)
						or item:GetAttribute("IsGun") == true
					then
						if not item:FindFirstChild("Stab", true) and item.Name ~= "Knife" then
							return item
						end
					end
				elseif weaponType == "Knife" then
					if item.Name == "Knife"
						or item:FindFirstChild("Stab", true)
						or item:FindFirstChild("Slash", true)
						or item:GetAttribute("IsKnife") == true
					then
						return item
					end
				end
			end
		end
		return nil
	end

	local inChar = SearchContainer(GetCharacter(plr))
	if inChar then return inChar end

	local inBag = SearchContainer(plr:FindFirstChildOfClass("Backpack"))
	if inBag then return inBag end

	return nil
end

local function HasTool(plr, weaponType)
	return GetMM2Tool(plr, weaponType) ~= nil
end

local function GetMurdererInstant()
	if Runtime.MurdererPlayer and IsAlive(Runtime.MurdererPlayer) then
		return Runtime.MurdererPlayer
	end
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and IsAlive(plr) and HasTool(plr, "Knife") then
			Runtime.MurdererPlayer = plr
			return plr
		end
	end
	return nil
end

local function UpdateRolesScan()
	local foundMurd = nil
	local foundSheriff = nil

	for _, plr in ipairs(Players:GetPlayers()) do
		if IsAlive(plr) then
			if HasTool(plr, "Knife") then
				foundMurd = plr
			end
			if HasTool(plr, "Gun") then
				foundSheriff = plr
			end
		end
	end

	local ok, playerData = pcall(function()
		local remote = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
		if remote and remote:IsA("RemoteFunction") then
			return remote:InvokeServer()
		end
		return nil
	end)

	if ok and type(playerData) == "table" then
		local myData = playerData[LocalPlayer.Name]
		if type(myData) == "table" then
			Runtime.IsDeadInLobby = (myData.Dead == true)
		else
			Runtime.IsDeadInLobby = true
		end

		for plrName, data in pairs(playerData) do
			local plr = Players:FindFirstChild(plrName)
			if plr and type(data) == "table" and not data.Dead and IsAlive(plr) then
				if data.Role == "Murderer" and not foundMurd then
					foundMurd = plr
				elseif (data.Role == "Sheriff" or data.Role == "Hero") and not foundSheriff then
					foundSheriff = plr
				end
			end
		end
	end

	if foundMurd then
		Runtime.MurdererPlayer = foundMurd
	elseif Runtime.MurdererPlayer and not IsAlive(Runtime.MurdererPlayer) then
		Runtime.MurdererPlayer = nil
	end

	if foundSheriff then
		Runtime.SheriffPlayer = foundSheriff
	elseif Runtime.SheriffPlayer and not IsAlive(Runtime.SheriffPlayer) then
		Runtime.SheriffPlayer = nil
	end
end

local function GetPlayerRole(plr)
	if not plr then return "Innocent" end
	if HasTool(plr, "Knife") or Runtime.MurdererPlayer == plr then
		return "Murderer"
	elseif HasTool(plr, "Gun") or Runtime.SheriffPlayer == plr then
		return "Sheriff"
	end
	return "Innocent"
end

-- Cache ultra-rapide pour CoinContainer
local function GetActiveCoinContainer()
	if Runtime.CachedCoinContainer and Runtime.CachedCoinContainer.Parent then
		return Runtime.CachedCoinContainer, Runtime.CachedCoinContainer.Parent
	end
	for _, obj in ipairs(Workspace:GetChildren()) do
		if obj:IsA("Model") or obj:IsA("Folder") then
			local cc = obj:FindFirstChild("CoinContainer")
			if cc then
				Runtime.CachedCoinContainer = cc
				return cc, obj
			end
		end
	end
	return nil, nil
end

local function GetActiveMap()
	local _, map = GetActiveCoinContainer()
	if map then return map end
	for _, obj in ipairs(Workspace:GetChildren()) do
		if (obj:IsA("Model") or obj:IsA("Folder")) and obj.Name ~= "Lobby" then
			if obj:FindFirstChild("Spawns") or obj:FindFirstChild("Map") then
				return obj
			end
		end
	end
	return nil
end

-- Vérifie si le joueur local est réellement dans la carte de la manche (et PAS au Lobby)
local function IsLocalPlayerInActiveRound(coinContainer, localHRP)
	if not coinContainer or not coinContainer.Parent or not localHRP then
		return false
	end

	if Runtime.IsDeadInLobby then
		return false
	end

	local lobby = Workspace:FindFirstChild("Lobby")
	if lobby then
		local lobbySpawn = lobby:FindFirstChildWhichIsA("SpawnLocation", true)
			or lobby:FindFirstChildWhichIsA("BasePart", true)
		if lobbySpawn and (localHRP.Position - lobbySpawn.Position).Magnitude < 135 then
			return false
		end
	end

	local map = coinContainer.Parent
	local spawns = map and map:FindFirstChild("Spawns")
	if spawns then
		local spawnList = spawns:GetChildren()
		if #spawnList > 0 then
			local minSpawnDist = math.huge
			for _, sp in ipairs(spawnList) do
				if sp:IsA("BasePart") then
					local d = (Vector3.new(localHRP.Position.X, sp.Position.Y, localHRP.Position.Z) - sp.Position).Magnitude
					if d < minSpawnDist then
						minSpawnDist = d
					end
				end
			end
			if minSpawnDist > 260 then
				return false
			end
		end
	end

	local children = coinContainer:GetChildren()
	if #children > 0 then
		local firstItem = children[1]
		local part = firstItem:IsA("BasePart") and firstItem or firstItem:FindFirstChildWhichIsA("BasePart")
		if part then
			local horizDist = (Vector3.new(localHRP.Position.X, part.Position.Y, localHRP.Position.Z) - part.Position).Magnitude
			if horizDist > 280 then
				return false
			end
		end
	end

	return true
end

local function FindGunDrop()
	for _, obj in ipairs(Workspace:GetChildren()) do
		if obj.Name == "GunDrop" and obj:IsA("BasePart") then
			return obj
		end
		if obj:IsA("Model") or obj:IsA("Folder") then
			local gd = obj:FindFirstChild("GunDrop")
			if gd and gd:IsA("BasePart") then
				return gd
			end
		end
	end
	return nil
end

