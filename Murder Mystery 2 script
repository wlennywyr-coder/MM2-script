-- ============================================================================
local function GetPredictedMurdererPos()
    local murderer = FindMurderer()
    local murdRoot = GetRootPart(murderer)
    if murdRoot then
        return murdRoot.Position + (murdRoot.AssemblyLinearVelocity * 0.14)
    end
    return nil
end

local function ShootMurdererNow()
    local murderer = FindMurderer()
    local myChar = GetCharacter(LocalPlayer)
    local myRoot = GetRootPart(LocalPlayer)
    local targetPos = GetPredictedMurdererPos()
    if not (myChar and myRoot and targetPos) then return end

    local gun = myChar:FindFirstChild("Gun") or myChar:FindFirstChild("Revolver")
    if not gun then
        local bp = LocalPlayer:FindFirstChild("Backpack")
        local bpGun = bp and (bp:FindFirstChild("Gun") or bp:FindFirstChild("Revolver"))
        local hum = GetHumanoid(LocalPlayer)
        if bpGun and hum then
            hum:EquipTool(bpGun)
            task.wait(0.05)
            gun = myChar:FindFirstChild("Gun") or myChar:FindFirstChild("Revolver") or bpGun
        end
    end

    if gun then
        -- 1. Direct MM2 Gun Remote Invocation (True Silent Shoot)
        local firedRemote = false
        pcall(function()
            local createBeam = gun:FindFirstChild("CreateBeam", true)
            local remoteFunc = createBeam and createBeam:FindFirstChildOfClass("RemoteFunction")
            if remoteFunc then
                firedRemote = true
                task.spawn(function()
                    remoteFunc:InvokeServer(1, targetPos, "AH2")
                end)
            end
        end)

        -- 2. Fallback instantaneous silent flick if custom gun script is used
        if not firedRemote then
            local savedCam = Camera.CFrame
            Camera.CFrame = CFrame.new(savedCam.Position, targetPos)
            gun:Activate()
            task.defer(function()
                Camera.CFrame = savedCam
            end)
        end
    end
end

-- Hook Gun activation so manual left-clicks with Silent Aim enabled hit the Murderer without moving the camera
local function HookCharacterTools(char)
    if not char then return end
    char.ChildAdded:Connect(function(child)
        if child:IsA("Tool") and (child.Name == "Gun" or child.Name == "Revolver") then
            child.Activated:Connect(function()
                if Settings.SilentAim then
                    local targetPos = GetPredictedMurdererPos()
                    if targetPos then
                        pcall(function()
                            local createBeam = child:FindFirstChild("CreateBeam", true)
                            local remoteFunc = createBeam and createBeam:FindFirstChildOfClass("RemoteFunction")
                            if remoteFunc then
                                remoteFunc:InvokeServer(1, targetPos, "AH2")
                            end
                        end)
                    end
                end
            end)
        end
    end)
end

