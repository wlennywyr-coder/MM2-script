task.spawn(function()
	while ScreenGui.Parent do
		if IsAlive(LocalPlayer) then
			local hasKnife = HasTool(LocalPlayer, "Knife")
			local hasGun = HasTool(LocalPlayer, "Gun")
			local murd = GetMurdererInstant()

			if (Config.AutoKillAll or Config.AutoEndRound) and hasKnife then
				local char = GetCharacter(LocalPlayer)
				local hum = GetHumanoid(LocalPlayer)
				local localHRP = GetRootPart(LocalPlayer)
				local knife = GetMM2Tool(LocalPlayer, "Knife")

				if knife and localHRP then
					if knife.Parent ~= char and hum then
						pcall(function() hum:EquipTool(knife) end)
					end
					for _, plr in ipairs(Players:GetPlayers()) do
						if plr ~= LocalPlayer and IsAlive(plr) then
							local tHRP = GetRootPart(plr)
							if tHRP then
								tHRP.CFrame = localHRP.CFrame * CFrame.new(0, 0, -2)
							end
						end
					end
					local stabRemote = knife:FindFirstChild("Stab", true)
						or knife:FindFirstChildWhichIsA("RemoteEvent", true)
					if stabRemote then
						pcall(function() stabRemote:FireServer("Slash") end)
					end
					pcall(function() knife:Activate() end)
				end
			end

			if (Config.KillMurdererBlatant or Config.AutoEndRound) and hasGun and murd and IsAlive(murd) then
				PerformVertexSheriffShot(true, false)
			end

			if Config.AutoShootMurderer and hasGun and murd and IsAlive(murd) then
				local localHRP = GetRootPart(LocalPlayer)
				local murdHRP = GetRootPart(murd)
				if localHRP and murdHRP then
					local rayParams = RaycastParams.new()
					rayParams.FilterType = Enum.RaycastFilterType.Exclude
					rayParams.FilterDescendantsInstances = { GetCharacter(LocalPlayer), GetCharacter(murd) }

					local direction = murdHRP.Position - localHRP.Position
					local rayResult = Workspace:Raycast(localHRP.Position, direction, rayParams)
					if not rayResult then
						PerformVertexSheriffShot(false, false)
					end
				end
			end
		end
		task.wait(0.15)
	end
end)

