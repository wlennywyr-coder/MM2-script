local function GetCoinBasePart(obj)
    if obj:IsA("BasePart") then return obj end
    if obj:IsA("Model") then return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart") end
    return nil
end

local function IsCoinCollectible(coinObj)
    if not coinObj or not coinObj.Parent then return false end
    local expTime = CollectedCoins[coinObj]
    if expTime and os.clock() < expTime then return false end
    local part = GetCoinBasePart(coinObj)
    if not part then return false end
    local visual = coinObj:FindFirstChild("CoinVisual")
    if visual and visual:IsA("BasePart") and visual.Transparency >= 0.95 then return false end
    if part.Transparency >= 0.95 and not visual then return false end
    return true
end

local function GetSafestMapCoin()
    local myRoot = GetRootPart(LocalPlayer)
    if not myRoot or not CachedCoinContainer or not CachedCoinContainer.Parent then return nil, nil end
    local murderer = FindMurderer()
    local murdRoot = (murderer ~= LocalPlayer) and GetRootPart(murderer) or nil
    local myPos = myRoot.Position
    local bestPart, bestObj = nil, nil
    local bestScore = -math.huge

    for _, child in ipairs(CachedCoinContainer:GetChildren()) do
        if IsCoinCollectible(child) then
            local part = GetCoinBasePart(child)
            if part then
                local coinPos = part.Position
                local distToMe = (coinPos - myPos).Magnitude
                if murdRoot and Settings.AvoidMurdererFarm then
                    local distToMurd = (coinPos - murdRoot.Position).Magnitude
                    if distToMurd >= 35 then
                        local score = (distToMurd * 2) - distToMe
                        if score > bestScore then bestScore = score bestPart = part bestObj = child end
                    end
                else
                    local score = -distToMe
                    if score > bestScore then bestScore = score bestPart = part bestObj = child end
                end
            end
        end
    end
    -- Fallback if AvoidMurderer blocked all coins
    if not bestPart and CachedCoinContainer then
        for _, child in ipairs(CachedCoinContainer:GetChildren()) do
            if IsCoinCollectible(child) then
                local part = GetCoinBasePart(child)
                if part then return part, child end
            end
        end
    end
    return bestPart, bestObj
end

local ProneAngles = CFrame.Angles(math.rad(90), 0, 0)

RunService.Heartbeat:Connect(function(dt)
    local myChar = GetCharacter(LocalPlayer)
    local myRoot = GetRootPart(LocalPlayer)
    local hum = GetHumanoid(LocalPlayer)
    if not (myChar and myRoot and hum and hum.Health > 0) then return end

    -- UNIVERSAL FLING
    local flingSubject = nil
    if Settings.FlingTarget and Settings.SelectedTarget then flingSubject = Settings.SelectedTarget
    elseif Settings.FlingMurderer then flingSubject = FindMurderer()
    elseif Settings.FlingSheriff then flingSubject = FindSheriff() end

    if flingSubject then
        local targetRoot = GetRootPart(flingSubject)
        local targetHum = GetHumanoid(flingSubject)
        if targetRoot and (not targetHum or targetHum.Health > 0) then
            hum.PlatformStand = true
            for _, part in ipairs(myChar:GetDescendants()) do if part:IsA("BasePart") then part.CanCollide = false end end
            -- Rapid orbit teleport
            local osc = math.sin(os.clock() * 60) * 1.6
            local targetPos = targetRoot.Position + (targetRoot.AssemblyLinearVelocity * 0.08) + Vector3.new(osc, 0, -osc)
            myRoot.CFrame = CFrame.new(targetPos) * CFrame.Angles(math.rad(math.random(1, 360)), math.rad(math.random(1, 360)), math.rad(math.random(1, 360)))
            myRoot.AssemblyLinearVelocity = Vector3.new(9999, 9999, 9999)
            myRoot.AssemblyAngularVelocity = Vector3.new(9999, 9999, 9999)
            return
        end
    end

    -- PURE CFRAME AUTOFARM (No Physics needed)
    if Settings.AutoFarmCoins or Settings.AutoFarmEvents then
        if Settings.SilentAim then DisableKnifeLocal() end

        if not IsPlayerInActiveMap(LocalPlayer) or CachedBagIsFull then
            if hum.PlatformStand then ForceStandUpright() end
            return
        end

        local targetPart, targetObj = GetSafestMapCoin()
        if not targetPart then return end

        hum.PlatformStand = true
        for _, part in ipairs(myChar:GetDescendants()) do if part:IsA("BasePart") then part.CanCollide = false end end
        myRoot.AssemblyLinearVelocity = Vector3.zero
        myRoot.AssemblyAngularVelocity = Vector3.zero

        local goalPos = Vector3.new(targetPart.Position.X, targetPart.Position.Y + Settings.UnderMapDepth, targetPart.Position.Z)
        local curPos = myRoot.Position
        local deltaVec = goalPos - curPos
        local dist3D = deltaVec.Magnitude
        local stepDist = Settings.FarmSpeed * dt

        if dist3D <= math.max(stepDist * 1.5, 2.5) then
            myRoot.CFrame = CFrame.new(goalPos) * ProneAngles
            if firetouchinterest then
                pcall(function() firetouchinterest(myRoot, targetPart, 0) firetouchinterest(myRoot, targetPart, 1) end)
            end
            CollectedCoins[targetObj] = os.clock() + 3.0
        else
            myRoot.CFrame = CFrame.new(curPos + (deltaVec.Unit * stepDist)) * ProneAngles
        end
    end
end)

