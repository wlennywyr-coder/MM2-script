		local targetHeight = isOpen and (42 + (#currentOptions * 28)) or 38
		TweenService:Create(container, TweenInfo.new(0.16), {
			Size = UDim2.new(1, 0, 0, targetHeight)
		}):Play()
	end)

	return {
		SetOptions = function(newOpts, keepSelection)
			if not keepSelection or not table.find(newOpts, selected) then
				selected = newOpts[1] or "None"
				displayLabel.Text = labelPrefix .. " • " .. tostring(selected)
				if callback then
