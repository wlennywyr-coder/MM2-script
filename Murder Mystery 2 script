	local HARMONY_FARM_SPEED = 24
	local undergroundRotation = CFrame.Angles(math.rad(90), 0, 0)
	local undergroundDepth = 2.8

	while ScreenGui.Parent do
		if Config.AutoFarm and not Runtime.IsFlinging and IsAlive(LocalPlayer) then
			local coinContainer = GetActiveCoinContainer()
			local localHRP = GetRootPart(LocalPlayer)
			local localHum = GetHumanoid(LocalPlayer)

			if coinContainer and localHRP and localHum and IsLocalPlayerInActiveRound(coinContainer, localHRP) then
				if Runtime.BagIsFull then
					CleanFarmPhysics()
					if Config.ResetWhenFull then
						if not Runtime.HasResetThisRound then
							Runtime.HasResetThisRound = true
							pcall(function()
								localHum.Health = 0
							end)
						end
					else
						if not Runtime.HasReturnedToMapThisRound then
							Runtime.HasReturnedToMapThisRound = true
							TeleportToActiveMap()
						end
					end
					task.wait(0.4)
				else
					Runtime.HasResetThisRound = false
					Runtime.HasReturnedToMapThisRound = false
					Runtime.IsCurrentlyFarming = true

					if not Runtime.FarmBodyVelocity or Runtime.FarmBodyVelocity.Parent ~= localHRP then
						if Runtime.FarmBodyVelocity then
							pcall(function() Runtime.FarmBodyVelocity:Destroy() end)
						end
						local bv = Instance.new("BodyVelocity")
						bv.Name = "HarmonyUndergroundBV"
						bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
						bv.Velocity = Vector3.zero
						bv.Parent = localHRP
						Runtime.FarmBodyVelocity = bv
					end

					localHum.PlatformStand = true

					local coins = GetValidCoinsList(coinContainer)
					local chosenEntry = SelectTargetCoin(coins, localHRP)

					if chosenEntry and IsCoinActive(chosenEntry.ContainerItem, chosenEntry.VisualPart) then
						local coinPos = chosenEntry.TouchPart.Position
						local targetUnderCF = CFrame.new(coinPos.X, coinPos.Y - undergroundDepth, coinPos.Z) * undergroundRotation

						if math.abs(localHRP.Position.Y - (coinPos.Y - undergroundDepth)) > 6 then
							local divePos = Vector3.new(localHRP.Position.X, coinPos.Y - undergroundDepth, localHRP.Position.Z)
							local diveDist = (divePos - localHRP.Position).Magnitude
							local diveTime = math.max(diveDist / HARMONY_FARM_SPEED, 0.05)
							local diveTween = TweenService:Create(
								localHRP,
								TweenInfo.new(diveTime, Enum.EasingStyle.Linear),
								{ CFrame = CFrame.new(divePos) * undergroundRotation }
							)
							Runtime.ActiveTween = diveTween
							diveTween:Play()
							local diveStart = os.clock()
							while Config.AutoFarm
								and not Runtime.IsFlinging
								and IsAlive(LocalPlayer)
								and not Runtime.BagIsFull
								and IsLocalPlayerInActiveRound(coinContainer, localHRP)
								and (os.clock() - diveStart) < diveTime
							do
								task.wait(0.04)
							end
						end

						local distance = (targetUnderCF.Position - localHRP.Position).Magnitude
						local duration = math.max(distance / HARMONY_FARM_SPEED, 0.05)

						local tween = TweenService:Create(
							localHRP,
							TweenInfo.new(duration, Enum.EasingStyle.Linear),
							{ CFrame = targetUnderCF }
						)
						Runtime.ActiveTween = tween
						tween:Play()

						local startWait = os.clock()
						local abortedForMurderer = false

						while Config.AutoFarm
							and not Runtime.IsFlinging
							and IsAlive(LocalPlayer)
							and not Runtime.BagIsFull
							and IsLocalPlayerInActiveRound(coinContainer, localHRP)
							and IsCoinActive(chosenEntry.ContainerItem, chosenEntry.VisualPart)
							and (os.clock() - startWait) < duration
						do
							if Config.AvoidMurderer then
								local murd = Runtime.MurdererPlayer
								local murdHRP = (murd and murd ~= LocalPlayer and IsAlive(murd)) and GetRootPart(murd) or nil
								if murdHRP and (murdHRP.Position - coinPos).Magnitude < 24 and #coins > 1 then
									abortedForMurderer = true
									break
								end
							end

							if (localHRP.Position - targetUnderCF.Position).Magnitude <= 3.2 then
								if type(fireTouch) == "function" then
									pcall(function()
										fireTouch(localHRP, chosenEntry.TouchPart, 0)
										fireTouch(localHRP, chosenEntry.TouchPart, 1)
									end)
								end
							end
							task.wait(0.04)
						end

						if tween then
							pcall(function() tween:Cancel() end)
						end

						if abortedForMurderer then
							Runtime.VisitedCoins[chosenEntry.ContainerItem] = true
						elseif Config.AutoFarm and not Runtime.IsFlinging and not Runtime.BagIsFull and IsCoinActive(chosenEntry.ContainerItem, chosenEntry.VisualPart) and localHRP then
							pcall(function()
								if type(fireTouch) == "function" then
									fireTouch(localHRP, chosenEntry.TouchPart, 0)
									fireTouch(localHRP, chosenEntry.TouchPart, 1)
								else
									chosenEntry.TouchPart.CanCollide = false
									chosenEntry.TouchPart.CFrame = localHRP.CFrame
								end
							end)
							Runtime.VisitedCoins[chosenEntry.ContainerItem] = true
							Runtime.CoinsCollectedSession += 1
							task.wait(0.04)
						else
							Runtime.VisitedCoins[chosenEntry.ContainerItem] = true
						end
					else
						table.clear(Runtime.VisitedCoins)
						task.wait(0.2)
					end
				end
			else
				if not coinContainer or not coinContainer.Parent then
					Runtime.BagIsFull = false
					Runtime.HasResetThisRound = false
					Runtime.HasReturnedToMapThisRound = false
				end
				CleanFarmPhysics()
				table.clear(Runtime.VisitedCoins)
				task.wait(0.35)
			end
		else
			CleanFarmPhysics()
			task.wait(0.25)
		end
		task.wait(0.04)
	end
end)

