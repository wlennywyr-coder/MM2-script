    if flingSubject then
        local myRoot = GetRootPart(LocalPlayer)
        local targetRoot = GetRootPart(flingSubject)
        local hum = GetHumanoid(LocalPlayer)
        if myRoot and targetRoot then
            if hum then hum.PlatformStand = true end
            -- Prédiction du mouvement de la cible + oscillation rapide à travers son HumanoidRootPart
            local offset = Vector3.new(math.random(-1, 1) * 0.5, 0, math.random(-1, 1) * 0.5)
            local predictedPos = targetRoot.Position + (targetRoot.AssemblyLinearVelocity * 0.08) + offset
            myRoot.CFrame = CFrame.new(predictedPos)
            myRoot.AssemblyLinearVelocity = Vector3.new(9e5, 9e5, 9e5)
            myRoot.AssemblyAngularVelocity = Vector3.new(9e5, 9e5, 9e5)
        end
    end
