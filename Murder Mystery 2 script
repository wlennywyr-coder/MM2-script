local function CleanFarmPhysics(forceClean)
	if not Runtime.IsCurrentlyFarming and not forceClean then
		return
	end
	Runtime.IsCurrentlyFarming = false

	if Runtime.ActiveTween then
		pcall(function() Runtime.ActiveTween:Cancel() end)
		Runtime.ActiveTween = nil
	end
	if Runtime.FarmBodyVelocity then
		pcall(function() Runtime.FarmBodyVelocity:Destroy() end)
		Runtime.FarmBodyVelocity = nil
	end
	local char = GetCharacter(LocalPlayer)
	local hum = GetHumanoid(LocalPlayer)
	local hrp = GetRootPart(LocalPlayer)
	if hum then
		hum.PlatformStand = false
		pcall(function()
			hum:ChangeState(Enum.HumanoidStateType.GettingUp)
		end)
	end
	if hrp then
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
		local _, yRot, _ = hrp.CFrame:ToEulerAnglesYXZ()
		hrp.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(0, yRot, 0)
	end
	if char then
		for _, part in ipairs(char:GetChildren()) do
			if part:IsA("BasePart") and (part.Name == "Torso" or part.Name == "UpperTorso" or part.Name == "LowerTorso" or part.Name == "Head") then
				part.CanCollide = true
			end
		end
	end
end

local function StopFlingPhysics()
	if not Runtime.IsFlinging then return end
	Runtime.IsFlinging = false
	Runtime.ActiveFlingTarget = nil

	if Runtime.FlingBodyAngular then
		pcall(function() Runtime.FlingBodyAngular:Destroy() end)
		Runtime.FlingBodyAngular = nil
	end

	local localHRP = GetRootPart(LocalPlayer)
	local localHum = GetHumanoid(LocalPlayer)
	if localHum then
		localHum.PlatformStand = false
		pcall(function()
			localHum:ChangeState(Enum.HumanoidStateType.GettingUp)
		end)
	end

	if localHRP then
		localHRP.AssemblyLinearVelocity = Vector3.zero
		localHRP.AssemblyAngularVelocity = Vector3.zero
		if Runtime.PreFlingCFrame then
			localHRP.CFrame = Runtime.PreFlingCFrame
			Runtime.PreFlingCFrame = nil
		end
	end
end

local function ExecuteFlingOnPlayer(targetPlayer)
	if not targetPlayer or targetPlayer == LocalPlayer or not IsAlive(targetPlayer) then
		StopFlingPhysics()
		return
	end

	local localChar = GetCharacter(LocalPlayer)
	local targetChar = GetCharacter(targetPlayer)
	local localHRP = GetRootPart(LocalPlayer)
	local targetHRP = GetRootPart(targetPlayer)
	if not localChar or not targetChar or not localHRP or not targetHRP then
		StopFlingPhysics()
		return
	end

	if not Runtime.IsFlinging then
		Runtime.IsFlinging = true
		Runtime.PreFlingCFrame = localHRP.CFrame
	end
	Runtime.ActiveFlingTarget = targetPlayer

	for _, part in ipairs(localChar:GetChildren()) do
		if part:IsA("BasePart") then
			part.CanCollide = true
			part.CustomPhysicalProperties = PhysicalProperties.new(100, 0.3, 0.5)
		end
	end
	for _, part in ipairs(targetChar:GetChildren()) do
		if part:IsA("BasePart") then
			part.CanCollide = true
		end
	end

	if not Runtime.FlingBodyAngular or Runtime.FlingBodyAngular.Parent ~= localHRP then
		if Runtime.FlingBodyAngular then
			pcall(function() Runtime.FlingBodyAngular:Destroy() end)
		end
		local bav = Instance.new("BodyAngularVelocity")
		bav.Name = "HarmonyFlingBAV"
		bav.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
		bav.P = 9e9
		bav.AngularVelocity = Vector3.new(99999, 99999, 99999)
		bav.Parent = localHRP
		Runtime.FlingBodyAngular = bav
	end

	local targetVel = targetHRP.AssemblyLinearVelocity or Vector3.zero
	local phase = math.sin(os.clock() * 45)
	local dynamicOffset = (targetVel * 0.14 * phase) + Vector3.new(0, phase * 1.2, 0)
	local randomSpin = CFrame.Angles(math.rad(math.random(1, 360)), math.rad(math.random(1, 360)), math.rad(math.random(1, 360)))

	localHRP.CFrame = CFrame.new(targetHRP.Position + dynamicOffset) * randomSpin
	localHRP.AssemblyLinearVelocity = Vector3.new(9e5, 9e5, 9e5)
	localHRP.AssemblyAngularVelocity = Vector3.new(99999, 99999, 99999)
end

local function TeleportToLobby()
	CleanFarmPhysics(true)
	StopFlingPhysics()
	local hrp = GetRootPart(LocalPlayer)
	if not hrp then return end

	local lobbySpawn = Workspace:FindFirstChild("Lobby", true)
	if lobbySpawn then
		local spawnPart = lobbySpawn:FindFirstChildWhichIsA("SpawnLocation", true)
			or lobbySpawn:FindFirstChildWhichIsA("BasePart", true)
		if spawnPart then
			hrp.CFrame = CFrame.new(spawnPart.Position + Vector3.new(0, 4, 0))
			return
		end
	end

	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj:IsA("SpawnLocation") then
			hrp.CFrame = CFrame.new(obj.Position + Vector3.new(0, 4, 0))
			return
		end
	end
	hrp.CFrame = CFrame.new(-108, 138, 18)
end

local function TeleportToActiveMap()
	CleanFarmPhysics(true)
	StopFlingPhysics()
	local hrp = GetRootPart(LocalPlayer)
	if not hrp then return end

	local map = GetActiveMap()
	if map then
		local spawns = map:FindFirstChild("Spawns")
		if spawns then
			local children = spawns:GetChildren()
			if #children > 0 then
				local targetPart = children[math.random(1, #children)]
				if targetPart:IsA("BasePart") then
					hrp.CFrame = CFrame.new(targetPart.Position + Vector3.new(0, 4.5, 0))
					return
				end
			end
		end
		local coinContainer = map:FindFirstChild("CoinContainer")
		if coinContainer then
			local coins = coinContainer:GetChildren()
			if #coins > 0 then
				local sample = coins[1]
				local part = sample:IsA("BasePart") and sample or sample:FindFirstChildWhichIsA("BasePart")
				if part then
					hrp.CFrame = CFrame.new(part.Position + Vector3.new(0, 4.5, 0))
					return
				end
			end
		end
		local anyPart = map:FindFirstChildWhichIsA("BasePart", true)
		if anyPart then
			hrp.CFrame = CFrame.new(anyPart.Position + Vector3.new(0, 5, 0))
		end
	end
end

