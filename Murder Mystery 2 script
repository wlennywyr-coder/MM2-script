                    bg.Name = "HBG" bg.Size = UDim2.new(0, 160, 0, 28) bg.StudsOffset = Vector3.new(0, 2.6, 0) bg.AlwaysOnTop = true
                    local tag = bg:FindFirstChild("Tag") or Instance.new("TextLabel", bg)
                    tag.Name = "Tag" tag.Size = UDim2.new(1,0,1,0) tag.BackgroundTransparency = 1 tag.Font = Enum.Font.GothamBold tag.TextSize = 12 tag.TextColor3 = col
                    tag.Text = string.format("%s [%s]", p.Name, role)
                elseif head:FindFirstChild("HBG") then head.HBG:Destroy() end
            end
        end
    end

    local gDrop = Workspace:FindFirstChild("GunDrop", true)
    if gDrop and gDrop:IsA("BasePart") then
        if Settings.GunCham then
            local ghl = gDrop:FindFirstChild("GHL") or Instance.new("Highlight", gDrop)
            ghl.Name = "GHL" ghl.Adornee = gDrop ghl.FillColor = Theme.GunDropColor ghl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            local gbg = gDrop:FindFirstChild("GBG") or Instance.new("BillboardGui", gDrop)
            gbg.Name = "GBG" gbg.Size = UDim2.new(0,140,0,30) gbg.StudsOffset = Vector3.new(0,2,0) gbg.AlwaysOnTop = true
            local gTag = gbg:FindFirstChild("Tag") or Instance.new("TextLabel", gbg)
            gTag.Name = "Tag" gTag.Size = UDim2.new(1,0,1,0) gTag.BackgroundTransparency = 1 gTag.Text = "★ [ GUN DROP ] ★" gTag.Font = Enum.Font.GothamBlack gTag.TextSize = 13 gTag.TextColor3 = Theme.GunDropColor
        else
            if gDrop:FindFirstChild("GHL") then gDrop.GHL:Destroy() end
            if gDrop:FindFirstChild("GBG") then gDrop.GBG:Destroy() end
        end
    end
end)
