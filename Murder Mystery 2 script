local function GetPredictedMurdererPosition()
    local murderer = FindMurderer()
    if not murderer or not murderer.Character then return nil end
    local murdRoot = murderer.Character:FindFirstChild("HumanoidRootPart") or murderer.Character:FindFirstChild("UpperTorso") or murderer.Character:FindFirstChild("Torso")
    if murdRoot then
        return murdRoot.Position + (murdRoot.AssemblyLinearVelocity * 0.12)
    end
    return nil
end

local function FireMM2GunRemote(gunTool, targetPos)
    if not gunTool or not targetPos then return false end
    local fired = false

    local knifeServer = gunTool:FindFirstChild("KnifeServer")
    local shootGun = knifeServer and knifeServer:FindFirstChild("ShootGun")
    if shootGun and shootGun:IsA("RemoteFunction") then
        fired = true
        task.spawn(function()
            pcall(function() shootGun:InvokeServer(1, targetPos, "AH2") end)
        end)
    end

    local createBeam = gunTool:FindFirstChild("CreateBeam", true)
    local beamRemote = createBeam and createBeam:FindFirstChildOfClass("RemoteFunction")
    if beamRemote then
        fired = true
        task.spawn(function()
            pcall(function() beamRemote:InvokeServer(1, targetPos, "AH2") end)
        end)
    end

    if not fired then
        for _, desc in ipairs(gunTool:GetDescendants()) do
            if desc:IsA("RemoteFunction") then
                fired = true
                local r = desc
                task.spawn(function()
                    pcall(function() r:InvokeServer(1, targetPos, "AH2") end)
                    pcall(function() r:InvokeServer(targetPos) end)
                end)
            end
        end
    end
    return fired
end

local isShootingMacro = false
local function ShootMurdererNow()
    if isShootingMacro then return end
    local targetPos = GetPredictedMurdererPosition()
    local myChar = GetCharacter(LocalPlayer)
    local hum = GetHumanoid(LocalPlayer)
    if not (myChar and hum and targetPos) then return end

    isShootingMacro = true
    task.spawn(function()
        local gun = myChar:FindFirstChild("Gun") or myChar:FindFirstChild("Revolver")
        if not gun then
            local bp = LocalPlayer:FindFirstChild("Backpack")
            local bpGun = bp and (bp:FindFirstChild("Gun") or bp:FindFirstChild("Revolver"))
            if bpGun then
                hum:EquipTool(bpGun)
                local timeout = 0
                repeat
                    task.wait(0.03)
                    timeout = timeout + 0.03
                    gun = myChar:FindFirstChild("Gun") or myChar:FindFirstChild("Revolver")
                until gun or timeout >= 0.35
                task.wait(0.08)
            end
        end

        if gun then
            local freshTargetPos = GetPredictedMurdererPosition() or targetPos
            FireMM2GunRemote(gun, freshTargetPos)
            pcall(function() gun:Activate() end)
        end
        task.wait(0.15)
        isShootingMacro = false
    end)
end

-- Instant Kill All (Without dragging players onto your screen or triggering in the lobby)
local isKillingAll = false
local function ExecuteInstantKillAll()
    if isKillingAll then return end
    if not HasItem(LocalPlayer, "Knife") or not IsPlayerInActiveMap(LocalPlayer) then
        return
    end

    local myChar = GetCharacter(LocalPlayer)
    local myRoot = GetRootPart(LocalPlayer)
    local hum = GetHumanoid(LocalPlayer)
    if not (myChar and myRoot and hum and hum.Health > 0) then return end

    isKillingAll = true
    task.spawn(function()
        local knife = myChar:FindFirstChild("Knife")
        if not knife then
            local bp = LocalPlayer:FindFirstChild("Backpack")
            local bpKnife = bp and bp:FindFirstChild("Knife")
            if bpKnife then
                hum:EquipTool(bpKnife)
                task.wait(0.1)
                knife = myChar:FindFirstChild("Knife")
            end
        end

        if knife then
            local handle = knife:FindFirstChild("Handle") or knife:FindFirstChildWhichIsA("BasePart")
            local slashRemote = knife:FindFirstChild("Slash", true) or knife:FindFirstChild("Stab", true)

            if slashRemote and slashRemote:IsA("RemoteEvent") then
                pcall(function() slashRemote:FireServer(1) end)
            end
            pcall(function() knife:Activate() end)

            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and IsPlayerInActiveMap(p) then
                    local tRoot = GetRootPart(p)
                    local tHum = GetHumanoid(p)
                    if tRoot and tHum and tHum.Health > 0 then
                        if firetouchinterest and handle then
                            pcall(function()
                                firetouchinterest(handle, tRoot, 0)
                                firetouchinterest(handle, tRoot, 1)
                            end)
                        else
                            -- Invisible 1-frame hit registration underneath the knife handle (not blocking camera)
                            local oldCF = tRoot.CFrame
                            tRoot.CFrame = (handle and handle.CFrame or myRoot.CFrame) * CFrame.new(0, -2.5, 0)
                            RunService.Heartbeat:Wait()
                            if tRoot and tRoot.Parent then
                                tRoot.CFrame = oldCF
                            end
                        end
                    end
                end
            end
        end
        task.wait(0.35)
        isKillingAll = false
    end)
end

