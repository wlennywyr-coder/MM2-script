-- Recherche de la pièce, du bonbon ou du flocon le plus proche
local function FindNearestCollectible()
    local myRoot = GetRootPart(LocalPlayer)
    if not myRoot then return nil end

    local nearestObj = nil
    local shortestDist = math.huge

    for _, desc in ipairs(Workspace:GetDescendants()) do
        if desc:IsA("BasePart") then
            local name = string.lower(desc.Name)
            local isCoin = (name == "coin_server" or name == "coin")
            local isEventCurrency = (
                string.find(name, "candy") or
                string.find(name, "snow") or
                string.find(name, "token") or
                (desc.Parent and desc.Parent.Name == "CoinContainer")
            )

            if (Settings.AutoFarmCoins and isCoin) or (Settings.AutoFarmEvents and (isEventCurrency or isCoin)) then
                local dist = (desc.Position - myRoot.Position).Magnitude
                if dist < shortestDist and dist < 250 then
                    shortestDist = dist
                    nearestObj = desc
                end
            end
        end
    end
    return nearestObj, shortestDist
end

-- Boucle Autofarm fluide (TweenService pour éviter les téléportations brusques)
task.spawn(function()
    while task.wait(0.25) do
        if Settings.AutoFarmCoins or Settings.AutoFarmEvents then
            local targetCoin, dist = FindNearestCollectible()
            local myRoot = GetRootPart(LocalPlayer)
            if targetCoin and myRoot then
                local duration = math.clamp(dist / 24, 0.15, 2.5)
                local tween = TweenService:Create(
                    myRoot,
                    TweenInfo.new(duration, Enum.EasingStyle.Linear),
                    {CFrame = CFrame.new(targetCoin.Position + Vector3.new(0, 2, 0))}
                )
                tween:Play()
                tween.Completed:Wait()
            end
        end
    end
end)

