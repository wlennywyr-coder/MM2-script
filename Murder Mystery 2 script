-- ============================================================================
-- CHARACTER, MAP & ROLE UTILITIES
-- ============================================================================
local function GetCharacter(player)
    return player and player.Character
end

local function GetRootPart(player)
    local char = GetCharacter(player)
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function GetHumanoid(player)
    local char = GetCharacter(player)
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function HasItem(player, itemName)
    if not player then return false end
    local backpack = player:FindFirstChild("Backpack")
    local char = GetCharacter(player)
    if backpack and backpack:FindFirstChild(itemName) then return true end
    if char and char:FindFirstChild(itemName) then return true end
    return false
end

-- Checks if a player is actually inside the active map (and not standing in the Lobby)
local function IsPlayerInActiveMap(player)
    local root = GetRootPart(player)
    if not root or not CachedCoinContainer or not CachedCoinContainer.Parent then
        return false
    end
    if CachedDeadPlayers[player.Name] then
        return false
    end

    -- Compare horizontal distance to the map's CoinContainer or Spawns
    local mapModel = CachedCoinContainer.Parent
    local refPos = nil

    local firstCoin = CachedCoinContainer:FindFirstChildWhichIsA("BasePart", true)
    if firstCoin then
        refPos = firstCoin.Position
    elseif mapModel:IsA("Model") and mapModel.PrimaryPart then
        refPos = mapModel.PrimaryPart.Position
    else
        local anyPart = mapModel:FindFirstChildWhichIsA("BasePart", true)
        if anyPart then refPos = anyPart.Position end
    end

    if not refPos then return false end
    local flatDist = (Vector3.new(root.Position.X, 0, root.Position.Z) - Vector3.new(refPos.X, 0, refPos.Z)).Magnitude
    return flatDist < 240
end

local function GetPlayerRole(player)
    if not player then return "Innocent" end
    -- Physical weapon check always takes priority
    if HasItem(player, "Knife") then return "Murderer" end
    if HasItem(player, "Gun") or HasItem(player, "Revolver") then return "Sheriff" end

    -- Only use pre-round cached roles if the round is genuinely active and player isn't dead in lobby
    if RoundIsActive and not CachedDeadPlayers[player.Name] then
        local cached = CachedRoles[player.Name]
        if cached == "Murderer" then
            return "Murderer"
        elseif cached == "Sheriff" or cached == "Hero" then
            return "Sheriff"
        end
    end
    return "Innocent"
end

local function FindMurderer()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and GetPlayerRole(p) == "Murderer" then
            return p
        end
    end
    return nil
end

local function FindSheriff()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and GetPlayerRole(p) == "Sheriff" then
            return p
        end
    end
    return nil
end

-- ============================================================================
-- POSTURE & PHYSICS RESTORATION (KEEPS CHARACTER STANDING UPRIGHT IN LOBBY)
-- ============================================================================
local function ForceStandUpright()
    local root = GetRootPart(LocalPlayer)
    local hum = GetHumanoid(LocalPlayer)
    local char = GetCharacter(LocalPlayer)

    if root then
        local bv = root:FindFirstChild("HarmonyFarmBV")
        if bv then bv:Destroy() end
        local bg = root:FindFirstChild("HarmonyFarmBG")
        if bg then bg:Destroy() end
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero

        -- If the character is tilted horizontally (prone), stand them back up vertically
        local _, yYaw, _ = root.CFrame:ToEulerAnglesYXZ()
        local lookFlat = root.CFrame.LookVector
        if math.abs(lookFlat.Y) > 0.5 then
            root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, yYaw, 0)
        end
    end

    if hum then
        hum.PlatformStand = false
        if hum:GetState() == Enum.HumanoidStateType.PlatformStanding or hum:GetState() == Enum.HumanoidStateType.FallingDown then
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
    end

    if char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and (part.Name == "HumanoidRootPart" or part.Name == "Torso" or part.Name == "UpperTorso" or part.Name == "LowerTorso") then
                part.CanCollide = true
            end
        end
    end
end

local function FindMapSafeSurfacePos()
    if CachedCoinContainer and CachedCoinContainer.Parent then
        local mapModel = CachedCoinContainer.Parent
        local spawns = mapModel:FindFirstChild("Spawns") or mapModel:FindFirstChild("PlayerSpawns")
        if spawns then
            local firstSpawn = spawns:FindFirstChildWhichIsA("BasePart", true)
            if firstSpawn then
                return firstSpawn.CFrame + Vector3.new(0, 4, 0)
            end
        end
        local anyCoin = CachedCoinContainer:FindFirstChildWhichIsA("BasePart", true)
        if anyCoin then
            return CFrame.new(anyCoin.Position + Vector3.new(0, 4.5, 0))
        end
    end
    return nil
end

local function RestorePlayerToMapSurface()
    ForceStandUpright()
    local root = GetRootPart(LocalPlayer)
    if not root then return end

    if IsPlayerInActiveMap(LocalPlayer) then
        local surface = SavedMapReturnCFrame or FindMapSafeSurfacePos()
        if surface then
            root.CFrame = CFrame.new(surface.Position)
        else
            root.CFrame = CFrame.new(root.Position.X, root.Position.Y + 5, root.Position.Z)
        end
    end
    SavedMapReturnCFrame = nil
end

-- ============================================================================
-- FAST ASYNC ROLE, BAG & GUN DROP SCANNER (RUNS EVERY 0.25s, ZERO LAG)
-- ============================================================================
local function CheckIfBagFullUI()
    local pGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not pGui then return false end

    for _, desc in ipairs(pGui:GetDescendants()) do
        if desc:IsA("TextLabel") and desc.Visible then
            local txt = string.lower(desc.Text)
            if txt == "full" or txt == "full!" or string.find(txt, "bag full") then
                local p = desc.Parent
                if p and p:IsA("GuiObject") and p.Visible then
                    return true
                end
            end
            local cur, max = string.match(txt, "^(%d+)%s*/%s*(%d+)$")
            if cur and max then
                local nCur, nMax = tonumber(cur), tonumber(max)
                if nCur and nMax and nMax >= 10 and nCur >= nMax then
                    return true
                end
            end
        end
    end
    return false
end

task.spawn(function()
    while task.wait(0.25) do
        -- 1. Scan Workspace for CoinContainer and GunDrop
        local foundContainer = Workspace:FindFirstChild("CoinContainer", true)
        local foundGun = Workspace:FindFirstChild("GunDrop", true)

        if foundContainer ~= CachedCoinContainer then
            table.clear(CollectedCoins)
            BagFullHandledThisRound = false
            SavedMapReturnCFrame = nil
        end
        CachedCoinContainer = foundContainer
        CachedGunDrop = foundGun

        -- 2. Poll GetPlayerData every 0.25s for instant Pre-Round Role ESP & Lobby Reset
        local anyRoleAssigned = false
        local newRoles = {}
        local newDead = {}

        pcall(function()
            local getPlayerData = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
            if getPlayerData and getPlayerData:IsA("RemoteFunction") then
                local data = getPlayerData:InvokeServer()
                if type(data) == "table" then
                    for playerName, info in pairs(data) do
                        if type(info) == "table" then
                            if info.Dead or info.Killed then
                                newDead[playerName] = true
                            end
                            if info.Role and info.Role ~= "" and not info.Dead and not info.Killed then
                                newRoles[playerName] = info.Role
                                if info.Role == "Murderer" or info.Role == "Sheriff" or info.Role == "Hero" then
                                    anyRoleAssigned = true
                                end
                            end
                        end
                    end
                end
            end
        end)

        -- Also check if anyone physically holds a Knife or Gun
        for _, p in ipairs(Players:GetPlayers()) do
            if HasItem(p, "Knife") then
                newRoles[p.Name] = "Murderer"
                newDead[p.Name] = nil
                anyRoleAssigned = true
            elseif HasItem(p, "Gun") or HasItem(p, "Revolver") then
                newRoles[p.Name] = "Sheriff"
                newDead[p.Name] = nil
                anyRoleAssigned = true
            end
        end

        -- If round ended (no CoinContainer and no active Murderer/Sheriff), wipe old roles immediately
        if anyRoleAssigned or (foundContainer ~= nil) then
            RoundIsActive = true
            CachedRoles = newRoles
            CachedDeadPlayers = newDead
        else
            RoundIsActive = false
            table.clear(CachedRoles)
            table.clear(CachedDeadPlayers)
        end

        -- 3. Check Bag Full (only when local player is actually inside the active map)
        local inMap = IsPlayerInActiveMap(LocalPlayer)
        CachedBagIsFull = inMap and CheckIfBagFullUI()

        if CachedBagIsFull and not BagFullHandledThisRound then
            BagFullHandledThisRound = true
            if Settings.AutoResetAfterFarm then
                ForceStandUpright()
                local char = GetCharacter(LocalPlayer)
                local hum = GetHumanoid(LocalPlayer)
                if hum then hum.Health = 0 end
                if char then char:BreakJoints() end
            elseif Settings.AutoFarmCoins or Settings.AutoFarmEvents then
                RestorePlayerToMapSurface()
            end
        end
    end
end)

