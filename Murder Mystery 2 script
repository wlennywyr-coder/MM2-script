task.spawn(function()
	if ContentProvider then
		local preloadList = {}
		for _, data in pairs(ThemePresets) do
			if data.AssetId and data.AssetId ~= "" then
				local img1 = Instance.new("ImageLabel")
				img1.Image = "rbxthumb://type=Asset&id=" .. data.AssetId .. "&w=768&h=432"
				table.insert(preloadList, img1)

				local img2 = Instance.new("ImageLabel")
				img2.Image = "rbxassetid://" .. data.AssetId
				table.insert(preloadList, img2)
			end
		end
		pcall(function()
			ContentProvider:PreloadAsync(preloadList)
		end)
		for _, item in ipairs(preloadList) do
			pcall(function() item:Destroy() end)
		end
	end
end)

local function MinimizeToHarmonyIcon()
	MainWindow.Visible = false
	HarmonyMiniBtn.Visible = true
end

local function RestoreFromHarmonyIcon()
	HarmonyMiniBtn.Visible = false
	MainWindow.Visible = true
end

-- Gestion propre du clic et du glisser UNIQUEMENT sur le bouton "Harmony"
do
	local miniDragging = false
	local miniDragStart = nil
	local miniStartPos = nil
	local wasDragged = false

	HarmonyMiniBtn.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			miniDragging = true
			wasDragged = false
			miniDragStart = input.Position
			miniStartPos = HarmonyMiniBtn.Position
		end
	end)

	AddConnection(UserInputService.InputChanged, function(input)
		if miniDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - miniDragStart
			if delta.Magnitude > 6 then
				wasDragged = true
			end
			HarmonyMiniBtn.Position = UDim2.new(
				miniStartPos.X.Scale,
				miniStartPos.X.Offset + delta.X,
				miniStartPos.Y.Scale,
				miniStartPos.Y.Offset + delta.Y
			)
		end
	end)

	AddConnection(UserInputService.InputEnded, function(input)
		if miniDragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
			miniDragging = false
		end
	end)

	HarmonyMiniBtn.MouseButton1Click:Connect(function()
		if not wasDragged then
			RestoreFromHarmonyIcon()
		end
	end)
end

