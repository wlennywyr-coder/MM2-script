-- 4. SYSTÈME D'ÉMOTES NATIVES MM2 (SANS SURCHARGE D'ANIMATION ROBLOX DE BASE)
--==============================================================================

local function PlayNativeMM2Emote(emoteName)
	emoteName = tostring(emoteName or Config.SelectedEmote):lower()
	local hum = GetHumanoid(LocalPlayer)
	if not hum or hum.Health <= 0 then return end

	Runtime.LastEmoteFireTime = os.clock()
	Runtime.EmoteNeedsRefresh = false

	-- Appel direct et exclusif au système d'émotes natif de Murder Mystery 2 :
	-- ReplicatedStorage.Remotes.Misc.PlayEmote:Invoke(emoteName)
	task.spawn(function()
		pcall(function()
			local remotes = ReplicatedStorage:FindFirstChild("Remotes")
			local misc = remotes and remotes:FindFirstChild("Misc")
			local playEmote = (misc and misc:FindFirstChild("PlayEmote"))
				or ReplicatedStorage:FindFirstChild("PlayEmote", true)
				or LocalPlayer:FindFirstChild("PlayEmote", true)

			if playEmote then
				if playEmote:IsA("BindableFunction") then
					playEmote:Invoke(emoteName)
				elseif playEmote:IsA("RemoteEvent") then
					playEmote:FireServer(emoteName)
				elseif playEmote:IsA("RemoteFunction") then
					playEmote:InvokeServer(emoteName)
				elseif playEmote:IsA("BindableEvent") then
					playEmote:Fire(emoteName)
				end
			end
		end)
	end)
end

