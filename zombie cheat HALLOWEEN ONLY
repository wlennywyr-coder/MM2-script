local function RebindZombieSilentAim(gun)
	if not Config.ZombieSilentAim or not gun then
		DisconnectSilentHooks()
		return
	end
	local char = GetCharacter(LocalPlayer)
	if not char or gun.Parent ~= char then
		DisconnectSilentHooks()
		return
	end

	DisconnectSilentHooks()
	Runtime.SilentAimGunConn = gun.Activated:Connect(function()
		ShootClosestZombie(true)
	end)
	if LocalMouse then
		Runtime.SilentAimMouseConn = LocalMouse.Button1Down:Connect(function()
			if gun.Parent == char then ShootClosestZombie(true) end
		end)
	end
end

