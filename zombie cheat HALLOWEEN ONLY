-- Boucle ESP Zombies (Rouge) & Survivants (Vert/Bleu)
task.spawn(function()
	while ScreenGui.Parent do
		if Config.InfectionESP then
			for _, plr in ipairs(Players:GetPlayers()) do
				if plr ~= LocalPlayer and IsAlive(plr) then
					local char = GetCharacter(plr)
					local role = GetInfectionRole(plr)
					local col = (role == "Zombie") and Color3.fromRGB(255, 65, 95) or Color3.fromRGB(90, 220, 255)
					if char then
						local hl = Runtime.Highlights[plr]
						if not hl or hl.Parent ~= char then
							if hl then pcall(function() hl:Destroy() end) end
							hl = Instance.new("Highlight")
							hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
							hl.FillTransparency = 0.45
							hl.Adornee = char
							hl.Parent = char
							Runtime.Highlights[plr] = hl
						end
						hl.FillColor = col
						hl.OutlineColor = col
					end
				elseif Runtime.Highlights[plr] then
					pcall(function() Runtime.Highlights[plr]:Destroy() end)
					Runtime.Highlights[plr] = nil
				end
			end
		end
		task.wait(0.25)
	end
end)

-- Boucle Candy Auto Farm Underground (24 studs/s en évitant les Zombies)
AddConnection(RunService.Stepped, function()
	if Config.CandyAutoFarm and Runtime.IsCurrentlyFarming and LocalPlayer.Character then
		for _, part in ipairs(LocalPlayer.Character:GetChildren()) do
			if part:IsA("BasePart") and part.CanCollide then
				part.CanCollide = false
			end
		end
	end
end)

task.spawn(function()
	local rot = CFrame.Angles(math.rad(90), 0, 0)
	while ScreenGui.Parent do
		if Config.CandyAutoFarm and IsAlive(LocalPlayer) then
			local cc = Workspace:FindFirstChild("CoinContainer", true)
			local localHRP = GetRootPart(LocalPlayer)
			local localHum = GetHumanoid(LocalPlayer)
			if cc and localHRP and localHum then
				Runtime.IsCurrentlyFarming = true
				if not Runtime.FarmBodyVelocity or Runtime.FarmBodyVelocity.Parent ~= localHRP then
					if Runtime.FarmBodyVelocity then pcall(function() Runtime.FarmBodyVelocity:Destroy() end) end
					local bv = Instance.new("BodyVelocity")
					bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
					bv.Velocity = Vector3.zero
					bv.Parent = localHRP
					Runtime.FarmBodyVelocity = bv
				end
				localHum.PlatformStand = true

				local bestCandy, bestDist = nil, math.huge
				for _, item in ipairs(cc:GetChildren()) do
					if not Runtime.VisitedCandies[item] then
						local cv = item:FindFirstChild("CoinVisual")
						local part = item:IsA("BasePart") and item or (cv and cv:IsA("BasePart") and cv) or item:FindFirstChildWhichIsA("BasePart")
						local vis = (cv and cv:IsA("BasePart")) and cv or part
						if part and vis and vis.Transparency < 1 then
							local d = (part.Position - localHRP.Position).Magnitude
							if d < bestDist then
								bestDist = d
								bestCandy = { Item = item, Part = part, Vis = vis }
							end
						end
					end
				end

				if bestCandy and bestCandy.Part.Parent then
					local cPos = bestCandy.Part.Position
					local targetCF = CFrame.new(cPos.X, cPos.Y - 2.8, cPos.Z) * rot
					local dist = (targetCF.Position - localHRP.Position).Magnitude
					local dur = math.max(dist / 24, 0.05)

					local tw = TweenService:Create(localHRP, TweenInfo.new(dur, Enum.EasingStyle.Linear), { CFrame = targetCF })
					tw:Play()
					local t0 = os.clock()
					while Config.CandyAutoFarm and IsAlive(LocalPlayer) and bestCandy.Vis.Parent and bestCandy.Vis.Transparency < 1 and (os.clock() - t0) < dur do
						if (localHRP.Position - targetCF.Position).Magnitude <= 3.2 and type(fireTouch) == "function" then
							pcall(function()
								fireTouch(localHRP, bestCandy.Part, 0)
								fireTouch(localHRP, bestCandy.Part, 1)
							end)
						end
						task.wait(0.04)
					end
					pcall(function() tw:Cancel() end)
					Runtime.VisitedCandies[bestCandy.Item] = true
				else
					table.clear(Runtime.VisitedCandies)
					task.wait(0.2)
				end
			else
				Runtime.IsCurrentlyFarming = false
				if Runtime.FarmBodyVelocity then pcall(function() Runtime.FarmBodyVelocity:Destroy() end) Runtime.FarmBodyVelocity = nil end
				task.wait(0.3)
			end
		else
			Runtime.IsCurrentlyFarming = false
			task.wait(0.25)
		end
		task.wait(0.04)
	end
end)
