local function GetCharacter(plr)
	plr = plr or LocalPlayer
	return plr and plr.Character
end

local function GetRootPart(plr)
	local char = GetCharacter(plr)
	return char and char:FindFirstChild("HumanoidRootPart")
end

local function GetHumanoid(plr)
	local char = GetCharacter(plr)
	return char and char:FindFirstChildOfClass("Humanoid")
end

local function IsAlive(plr)
	local hum = GetHumanoid(plr)
	local hrp = GetRootPart(plr)
	return hum and hrp and hum.Health > 0
end

local function GetMM2Tool(plr, weaponType)
	if not plr then return nil end
	local function Search(container)
		if not container then return nil end
		for _, item in ipairs(container:GetChildren()) do
			if item:IsA("Tool") then
				if weaponType == "Gun" then
					if item.Name == "Gun" or item.Name == "Revolver" or item:FindFirstChild("Shoot", true) or item:FindFirstChild("CreateBeam", true) then
						if not item:FindFirstChild("Stab", true) and item.Name ~= "Knife" then
							return item
						end
					end
				elseif weaponType == "Knife" then
					if item.Name == "Knife" or item:FindFirstChild("Stab", true) or item:FindFirstChild("Slash", true) then
						return item
					end
				end
			end
		end
		return nil
	end
	return Search(GetCharacter(plr)) or Search(plr:FindFirstChildOfClass("Backpack"))
end

-- En mode Infection : Zombie = possède un Knife (ou Team Zombie/Infected) ; Survivant = possède un Gun
local function GetInfectionRole(plr)
	if not plr or not IsAlive(plr) then return "None" end
	if GetMM2Tool(plr, "Knife") then
		return "Zombie"
	elseif GetMM2Tool(plr, "Gun") then
		return "Survivor"
	end
	if plr.Team then
		local tName = string.lower(plr.Team.Name)
		if string.find(tName, "zombie") or string.find(tName, "infect") then
			return "Zombie"
		elseif string.find(tName, "survivor") then
			return "Survivor"
		end
	end
	return "Survivor"
end

-- Trouve le Zombie en vie le plus proche du joueur local (avec option Wallcheck)
local function GetClosestZombie(requireVisible)
	local localHRP = GetRootPart(LocalPlayer)
	if not localHRP then return nil, math.huge end

	local bestZombie = nil
	local bestDist = math.huge

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and IsAlive(plr) and GetInfectionRole(plr) == "Zombie" then
			local zHRP = GetRootPart(plr)
			if zHRP then
				local dist = (zHRP.Position - localHRP.Position).Magnitude
				if dist < bestDist then
					if requireVisible then
						local rayParams = RaycastParams.new()
						rayParams.FilterType = Enum.RaycastFilterType.Exclude
						rayParams.FilterDescendantsInstances = { GetCharacter(LocalPlayer), GetCharacter(plr) }
						local hit = Workspace:Raycast(localHRP.Position, zHRP.Position - localHRP.Position, rayParams)
						if not hit then
							bestDist = dist
							bestZombie = plr
						end
					else
						bestDist = dist
						bestZombie = plr
					end
				end
			end
		end
	end

	return bestZombie, bestDist
end

-- Trouve le Survivant le plus proche (quand on est soi-même Zombie)
local function GetClosestSurvivor()
	local localHRP = GetRootPart(LocalPlayer)
	if not localHRP then return nil, math.huge end

	local bestSurvivor = nil
	local bestDist = math.huge

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and IsAlive(plr) and GetInfectionRole(plr) == "Survivor" then
			local sHRP = GetRootPart(plr)
			if sHRP then
				local dist = (sHRP.Position - localHRP.Position).Magnitude
				if dist < bestDist then
					bestDist = dist
					bestSurvivor = plr
				end
			end
		end
	end

	return bestSurvivor, bestDist
end

local function GetPredictedZombiePos(zombiePlr)
	local char = GetCharacter(zombiePlr)
	local hrp = GetRootPart(zombiePlr)
	local hum = GetHumanoid(zombiePlr)
	if not char or not hrp then return nil, nil end

	local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or hrp
	local center = (hrp.Position * 0.65) + (torso.Position * 0.35)
	local vel = hrp.AssemblyLinearVelocity or Vector3.zero

	local ping = 0.065
	pcall(function()
		local np = LocalPlayer:GetNetworkPing()
		if type(np) == "number" and np > 0 then ping = math.clamp(np, 0.02, 0.22) end
	end)

	local hVel = Vector3.new(vel.X, 0, vel.Z)
	local moveVel = (hum and hum.MoveDirection.Magnitude > 0.05) and (hum.MoveDirection.Unit * 16) or hVel
	local effVel = (hVel * 0.55) + (moveVel * 0.45)

	local offset = effVel * (0.13 + ping * 0.6)
	if offset.Magnitude > 2.6 then offset = offset.Unit * 2.6 end

	local vOffset = (math.abs(vel.Y) > 2) and math.clamp(vel.Y * 0.07, -1.1, 1.3) or 0
	local predPos = center + offset + Vector3.new(0, vOffset, 0)
	return predPos, CFrame.new(predPos)
end

