local function DispatchGunRemotes(gunTool, targetPos, targetCF)
	if not gunTool or not targetPos then return end
	local localHRP = GetRootPart(LocalPlayer)
	local handle = gunTool:FindFirstChild("Handle")
	local originPos = (handle and handle:IsA("BasePart") and handle.Position)
		or (localHRP and localHRP.Position)
		or targetPos
	local originLookCF = CFrame.lookAt(originPos, targetPos)
	local finalTargetCF = targetCF or CFrame.new(targetPos)

	local shootRemote = gunTool:FindFirstChild("Shoot", true)
	if shootRemote then
		task.spawn(function()
			pcall(function()
				if shootRemote:IsA("RemoteEvent") then
					shootRemote:FireServer(originLookCF, finalTargetCF)
				elseif shootRemote:IsA("RemoteFunction") then
					shootRemote:InvokeServer(originLookCF, finalTargetCF)
				end
			end)
		end)
	end

	local createBeam = gunTool:FindFirstChild("CreateBeam", true)
	if createBeam then
		local rf = createBeam:FindFirstChild("RemoteFunction") or createBeam:FindFirstChildWhichIsA("RemoteFunction")
		if rf then
			task.spawn(function()
				pcall(function() rf:InvokeServer(1, targetPos, "AH2") end)
			end)
		end
	end
end

local function ShootClosestZombie(requireEquipped)
	if os.clock() - Runtime.ShootCooldown < 0.06 then return end
	if not IsAlive(LocalPlayer) then return end

	local char = GetCharacter(LocalPlayer)
	local hum = GetHumanoid(LocalPlayer)
	local gun = GetMM2Tool(LocalPlayer, "Gun")
	if not char or not hum or not gun then return end

	if requireEquipped and gun.Parent ~= char then return end

	local zombie = GetClosestZombie(false)
	if not zombie or not IsAlive(zombie) then return end

	Runtime.ShootCooldown = os.clock()

	if gun.Parent ~= char then
		pcall(function() hum:EquipTool(gun) end)
		if gun.Parent ~= char then pcall(function() gun.Parent = char end) end
	end

	local predPos, predCF = GetPredictedZombiePos(zombie)
	if predPos then
		DispatchGunRemotes(gun, predPos, predCF)
	end

	for _, d in ipairs({0.015, 0.04, 0.08}) do
		task.delay(d, function()
			if gun and gun.Parent == char then
				local z = GetClosestZombie(false)
				if z and IsAlive(z) then
					local p, cf = GetPredictedZombiePos(z)
					if p then DispatchGunRemotes(gun, p, cf) end
				end
			end
		end)
	end
end

