--==============================================================================
-- BOUCLES TEMPS RÉEL (ANTI-INFECTION, COMBAT ZOMBIE, ESP & CANDY FARM)
--==============================================================================

AddConnection(RunService.Heartbeat, function()
	if not IsAlive(LocalPlayer) then return end
	local localHRP = GetRootPart(LocalPlayer)
	local localChar = GetCharacter(LocalPlayer)
	local localHum = GetHumanoid(LocalPlayer)
	if not localHRP or not localChar or not localHum then return end

	local myRole = GetInfectionRole(LocalPlayer)

	-- 1. Anti-Infection : décale automatiquement le Survivant si un Zombie s'approche à moins de 16 studs
	if Config.AntiInfection and myRole == "Survivor" then
		local closestZ, dist = GetClosestZombie(false)
		if closestZ and dist < 16 then
			local zHRP = GetRootPart(closestZ)
			if zHRP then
				local awayDir = (localHRP.Position - zHRP.Position)
				awayDir = Vector3.new(awayDir.X, 0, awayDir.Z)
				if awayDir.Magnitude > 0.05 then
					localHRP.CFrame = localHRP.CFrame + (awayDir.Unit * 14)
				end
			end
		end
	end

	-- 2. Zombie Kill Aura & Auto Infect (quand on est Zombie)
	if myRole == "Zombie" and (Config.ZombieKillAura or Config.AutoInfectSurvivors) then
		local knife = GetMM2Tool(LocalPlayer, "Knife")
		if knife then
			if knife.Parent ~= localChar then
				pcall(function() localHum:EquipTool(knife) end)
			end
			local survivor, sDist = GetClosestSurvivor()
			if survivor and IsAlive(survivor) then
				local sHRP = GetRootPart(survivor)
				if sHRP and (Config.AutoInfectSurvivors or sDist <= 35) then
					sHRP.CFrame = localHRP.CFrame * CFrame.new(0, 0, -2.2)
					local stab = knife:FindFirstChild("Stab", true) or knife:FindFirstChildWhichIsA("RemoteEvent", true)
					if stab then pcall(function() stab:FireServer("Slash") end) end
					pcall(function() knife:Activate() end)
				end
			end
		end
	end
end)

