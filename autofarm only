RunService.Heartbeat:Connect(function(dt)
    local myChar = GetCharacter(LocalPlayer)
    local myRoot = GetRootPart(LocalPlayer)
    local hum = GetHumanoid(LocalPlayer)
    if not (myChar and myRoot and hum and hum.Health > 0) then return end

    if Settings.AutoFarmCoins or Settings.AutoFarmEvents then
        if not IsPlayerInActiveMap(LocalPlayer) or CachedBagIsFull then
            if hum.PlatformStand then ForceStandUpright() end
            return
        end

        local targetPart, targetObj = GetSafestMapCoin()
        if not targetPart then return end

        hum.PlatformStand = true
        myRoot.AssemblyLinearVelocity = Vector3.zero
        myRoot.AssemblyAngularVelocity = Vector3.zero

        local goalPos = Vector3.new(targetPart.Position.X, targetPart.Position.Y + Settings.UnderMapDepth, targetPart.Position.Z)
        local curPos = myRoot.Position
        local deltaVec = goalPos - curPos
        local dist3D = deltaVec.Magnitude
        local stepDist = Settings.FarmSpeed * dt

        if dist3D <= math.max(stepDist * 1.5, 2.5) then
            myRoot.CFrame = CFrame.new(goalPos) * ProneAngles
            local oldTransp = targetPart.Transparency
            targetPart.Transparency = 1
            if firetouchinterest then pcall(function() firetouchinterest(myRoot, targetPart, 0) firetouchinterest(myRoot, targetPart, 1) end) end
            CollectedCoins[targetObj] = os.clock() + 3.0
            task.delay(3, function() if targetPart then targetPart.Transparency = oldTransp end end)
        else
            myRoot.CFrame = CFrame.new(curPos + (deltaVec.Unit * stepDist)) * ProneAngles
        end
    end
end)
