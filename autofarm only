local function GetSafestMapCoin()
    local myRoot = GetRootPart(LocalPlayer)
    if not myRoot or not CachedCoinContainer or not CachedCoinContainer.Parent then return nil, nil end
    local murderer = FindMurderer()
    local murdRoot = murderer and GetRootPart(murderer)
    local myPos = myRoot.Position
    local bestPart, bestObj = nil, nil
    local bestScore = -math.huge

    for _, child in ipairs(CachedCoinContainer:GetChildren()) do
        local expTime = CollectedCoins[child]
        if not expTime or os.clock() >= expTime then
            local part = child:IsA("BasePart") and child or child:FindFirstChildWhichIsA("BasePart")
            if part and part.Transparency < 0.9 then
                local distToMe = (part.Position - myPos).Magnitude
                if murdRoot and Settings.AvoidMurdererFarm then
                    local distToMurd = (part.Position - murdRoot.Position).Magnitude
                    if distToMurd >= 35 then
                        local score = (distToMurd * 1.5) - distToMe
                        if score > bestScore then bestScore = score bestPart = part bestObj = child end
                    end
                else
                    local score = -distToMe
                    if score > bestScore then bestScore = score bestPart = part bestObj = child end
                end
            end
        end
    end
    if not bestPart and CachedCoinContainer then
        for _, child in ipairs(CachedCoinContainer:GetChildren()) do
            local exp = CollectedCoins[child]
            if not exp or os.clock() >= exp then
                local part = child:IsA("BasePart") and child or child:FindFirstChildWhichIsA("BasePart")
                if part and part.Transparency < 0.9 then return part, child end
            end
        end
    end
    return bestPart, bestObj
end

