local function CheckIfBagFullUI()
    local pGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not pGui then return false end
    for _, desc in ipairs(pGui:GetDescendants()) do
        if desc:IsA("TextLabel") and desc.Visible then
            local txt = string.lower(desc.Text)
            if txt == "full" or txt == "full!" or string.find(txt, "bag full") then return true end
            local cur, max = string.match(txt, "^(%d+)%s*/%s*(%d+)$")
            if cur and max then
                local nCur, nMax = tonumber(cur), tonumber(max)
                if nCur and nMax and nMax >= 10 and nCur >= nMax then return true end
            end
        end
    end
    return false
end

